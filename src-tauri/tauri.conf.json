{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jingwei",
  "version": "0.3.0",
  "identifier": "dev.hpeng.jingwei",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "经纬 · 开发环境与项目就绪检查器",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
