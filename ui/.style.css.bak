/* ============================================================================
   jingwei 外壳样式（全部重写）

   画风：温暖治愈 —— 奶油底、暖砂描边、陶土色点缀、柔和阴影、圆润但不含糊。
   严谨：暖色也必须过对比度（正文 ≥4.5:1，弱文字 ≥3:1）；
        间距只用 4/8/12/16/24/32；数据一律等宽+等宽数字；
        动效只动 transform/opacity，时长三档。

   颜色出处：色相与色阶取自 Tailwind 官方主题的 OKLCH 值（MIT），
            在暖色方向做了低饱和化处理（治愈感来自低饱和 + 足够对比）。
   ========================================================================= */

/* ── 颜色：直接采用 Radix Colors 的暖色阶（MIT）。
       每一档都是设计过的，对比度有保证；12 档里我们用得上的是
       1/2/3 当面、6/7/8 当描边、9/10 当实体填充、11/12 当文字。 ── */
:root{
  /* sand：暖中性（面和字） */
  --sand-1:#fdfdfc; --sand-2:#f9f9f8; --sand-3:#f1f0ef; --sand-4:#e9e8e6;
  --sand-6:#dad9d6; --sand-7:#cfceca; --sand-8:#bcbbb5;
  --sand-9:#8d8d86; --sand-11:#63635e; --sand-12:#21201c;

  --bg:      var(--sand-2);   /* 页面底 */
  --surface: var(--sand-1);   /* 卡片：比页面更亮一点，靠明度分层 */
  --inset:   var(--sand-3);   /* 内嵌块 */
  --sunken:  var(--sand-4);
  /* 工具窗的底色：比卡片略沉、带一点暖调。工具窗是「工作面」，
     不该和内容卡片一样白——不然整屏都是浮起来的纸。 */
  --tool-bg: color-mix(in srgb, var(--sand-4) 88%, #f0dcc4);
  --line:    var(--sand-6);   /* 发丝描边 */
  --line-2:  var(--sand-7);   /* 强一点的描边 */
  --fg:      var(--sand-12);  /* 正文：对卡片 ≈ 15:1 */
  --fg-2:    #3f3f3a;         /* 次级 */
  --muted:   var(--sand-11);  /* 弱文字：≈ 6:1 */
  --faint:   var(--sand-9);   /* 更弱：仅小标签 */
  --on-dark: #f6f6f4;

  /* amber：暖色主色（治愈感来自低饱和的暖黄，而不是扎眼的红） */
  --primary:      #ffc53d;    /* 实体填充 */
  --primary-fg:   #21201c;    /* 填充上的文字：深色，对比 ≈ 10:1 */
  --primary-text: #ab6400;    /* 浅底上的文字/图标 */
  --primary-soft: #fff7c2;
  --primary-line: #f3d673; --primary-hover: #f5b81f;

  /* tomato：错误（柔和的砖红，不刺眼） */
  --danger:      #e54d2e; --danger-text: #d13415; --danger-soft: #feebe7;
  /* grass：通过 */
  --ok:          #46a758; --ok-text:     #2a7e3b; --ok-soft:     #e9f6ec;
  /* amber-11：警告（和主色同族但更暗，用来区分"提醒"与"可点"） */
  --warn:        #ab6400; --warn-soft:   #fff7c2;
  /* 信息：不抢眼的暖蓝灰 */
  --info:        #3d6b8a; --info-soft:   #e9f1f6;

  /* 侧栏比页面略深一点，形成"纸叠纸"的层次，不靠阴影 */
  --side-bg: linear-gradient(180deg,#FBF6F0 0%,#F7EFE5 100%);
  --bar-bg:  #232220;   --bar-fg: #d5d3cd; --bar-dim: #8a8880;

  /* ── 圆角与阴影（柔光，不用硬边）────────────────────────── */
  --r-xs:6px; --r-sm:9px; --r:13px; --r-lg:17px; --r-xl:22px; --r-full:999px;
  --shadow-1: 0 1px 2px rgba(96,72,48,.05);
  --shadow-2: 0 1px 2px rgba(96,72,48,.05), 0 10px 24px -16px rgba(96,72,48,.28);
  --shadow-3: 0 2px 6px rgba(96,72,48,.07), 0 18px 40px -22px rgba(96,72,48,.38);
  --shadow-pop: 0 2px 8px rgba(96,72,48,.08), 0 24px 48px -20px rgba(96,72,48,.30);

  /* ── 间距：只用这六档（Carbon 8px 单元的实用子集）────────── */
  --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s5:24px; --s6:32px;

  /* ── 动效：三档 + 柔和缓动（治愈感来自"慢一点、软一点"）── */
  --t-fast:100ms; --t:170ms; --t-slow:260ms;
  --ease:cubic-bezier(.22,.61,.36,1);
  --ease-soft:cubic-bezier(.4,0,.2,1);

  /* ── 排版：行高 = 字号 + 3（JetBrains 规则）；数字等宽 ───── */
  --font:"Segoe UI Variable Text","Segoe UI","Microsoft YaHei UI","Microsoft YaHei",system-ui,sans-serif;
  --mono:"Cascadia Mono","Cascadia Code",Consolas,"JetBrains Mono",ui-monospace,monospace;
  --fs-sm:12.5px; --fs:13.5px; --fs-md:15px; --fs-lg:17px; --fs-xl:21px;
  --lh-sm:16px; --lh:17px; --lh-md:19px; --lh-lg:22px;

  /* ── 布局尺寸 ───────────────────────────────────────────── */
  --side:64px; --rail-w:328px; --top-h:66px; --bar-h:30px;
}

/* 夜灯（深色）：不用蓝黑，用暖炭色，像夜里开着一盏小灯 */
/* 夜灯：同样用 Radix 的 dark 色阶（暖炭色，不是蓝黑） */
[data-theme="dark"]{
  --sand-1:#111110; --sand-2:#191918; --sand-3:#222221; --sand-4:#2a2a28;
  --sand-6:#3b3a37; --sand-7:#4b4a46; --sand-8:#62605b;
  --sand-9:#8a8880; --sand-11:#b5b3ad; --sand-12:#eeeeec;
  --bg:var(--sand-1); --surface:var(--sand-2); --inset:var(--sand-3); --sunken:var(--sand-4);
  --line:var(--sand-6); --line-2:var(--sand-7);
  --fg:var(--sand-12); --fg-2:#d5d3cd; --muted:var(--sand-11); --faint:var(--sand-9);
  --primary:#ffc53d; --primary-fg:#21201c; --primary-text:#ffca16;
  --primary-soft:#302008; --primary-line:#5a4415; --primary-hover:#ffce5c;
  --danger:#e54d2e; --danger-text:#ff977d; --danger-soft:#391714;
  --ok:#46a758;     --ok-text:#7ec98a;     --ok-soft:#15251a;
  --warn:#ffca16;   --warn-soft:#302008;
  --info:#8ab0cc;   --info-soft:#1c2830;
  --side-bg:linear-gradient(180deg,#1d1d1c 0%,#141413 100%);
  --bar-bg:#0d0d0c; --bar-fg:#d5d3cd; --bar-dim:#8a8880;
  --shadow-1:0 1px 2px rgba(0,0,0,.35);
  --shadow-2:0 1px 2px rgba(0,0,0,.35), 0 10px 24px -16px rgba(0,0,0,.7);
  --shadow-3:0 2px 6px rgba(0,0,0,.4), 0 18px 40px -22px rgba(0,0,0,.8);
  --shadow-pop:0 2px 8px rgba(0,0,0,.45), 0 24px 48px -20px rgba(0,0,0,.85);
}

/* 密度：只改间距与字号，不改结构 */
[data-density="compact"]{ --s3:10px; --s4:13px; --s5:18px; --fs:13px; --fs-sm:12px; --fs-md:14px }
[data-density="loose"]{ --s3:15px; --s4:20px; --s5:30px; --fs:14.5px; --fs-sm:13.5px; --fs-md:16px }

/* 动效关闭 */
[data-motion="off"] *{ transition:none !important; animation:none !important }

/* ── 基础 ────────────────────────────────────────────────── */
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  background:var(--bg); color:var(--fg); overflow:hidden;
  font:var(--fs)/1.6 var(--font);
  -webkit-font-smoothing:antialiased;
  display:grid;
  grid-template-columns:var(--side) minmax(0,1fr) var(--rail-w);
  grid-template-rows:var(--top-h) minmax(0,1fr) auto var(--bar-h);
  grid-template-areas:"side top rail" "side main rail" "side band rail" "bar bar bar";
}
body.rail-off{ --rail-w:0px }
button{font:inherit;cursor:pointer;color:inherit}
input,select,textarea{font:inherit;color:inherit}
code,.mono{font-family:var(--mono)}
.grow{flex:1}
::selection{background:var(--primary-soft);color:var(--fg)}

/* 滚动条也做成暖色，别用系统默认的冷灰 */
*::-webkit-scrollbar{width:10px;height:10px}
*::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:99px;border:3px solid transparent;background-clip:content-box}
*::-webkit-scrollbar-thumb:hover{background:var(--faint);background-clip:content-box}
*::-webkit-scrollbar-track{background:transparent}

/* ── 侧栏 ────────────────────────────────────────────────── */
/* 窄导航条：只有图标，标签藏起来靠悬停提示（PCL2 的做法，横向空间全给内容） */
.side{
  grid-area:side; display:flex; flex-direction:column; align-items:center;
  padding:var(--s4) var(--s2); background:var(--side-bg); border-right:1px solid var(--line);
}
.side .lbl{display:none}
.side .btn{width:44px;height:36px;padding:0;justify-content:center}
.side .btn.caret{width:44px}
.brand{display:flex; align-items:center; justify-content:center; padding:var(--s1) 0 var(--s4); cursor:default}
.brand .mark{
  width:34px;height:34px;border-radius:var(--r-sm);flex:none;
  background:linear-gradient(150deg,var(--primary),#A9482A);
  box-shadow:0 2px 10px -3px rgba(191,91,56,.5);
  position:relative;
}
.brand .mark::after{  /* 图标：几何 D 的简化笔画 */
  content:""; position:absolute; inset:8px 9px 8px 8px;
  border:2.5px solid var(--primary-fg); border-left-width:0;
  border-radius:0 99px 99px 0;
}
.brand .mark::before{
  content:none;
}
/* 品牌标：几何化的 D + 两道横肋（和图标同源，线条一致） */
.brand .mark svg{position:absolute;inset:0;width:100%;height:100%;padding:6px;
  fill:none;stroke:var(--primary-fg);stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

/* 线性图标：统一粗细与端点，颜色跟随文字 */
.ic{width:15px;height:15px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;
  stroke-linecap:round;stroke-linejoin:round;opacity:.9}
.nav button .ic{width:16px;height:16px}
.btn .ic{width:14px;height:14px}
.iconbtn .ic{width:14px;height:14px}
.pstep .ic{width:15px;height:15px;color:var(--faint)}
.brand b{display:block;font-size:var(--fs-lg);font-weight:700;letter-spacing:.2px;line-height:1.25}
.brand span{display:block;font-size:var(--fs-sm);color:var(--muted);line-height:1.4}

.nav{display:flex;flex-direction:column;gap:2px;flex:1;width:100%;align-items:center}
.nav button{
  display:flex;align-items:center;justify-content:center;border:0;background:none;
  width:46px;height:46px;padding:0;border-radius:14px;color:var(--fg-2);font-weight:600;
  transition:background var(--t) var(--ease),color var(--t) var(--ease),transform var(--t-fast) var(--ease);
}
.nav button .ic{width:19px;height:19px;opacity:.85}
.nav button i{font-style:normal;width:16px;text-align:center;color:var(--faint);font-size:14px}
.nav button:hover{background:rgba(191,91,56,.07);color:var(--fg)}
.nav button:active{transform:scale(.99)}
.nav button.on{background:var(--primary-soft);color:var(--primary-text);box-shadow:inset 0 0 0 1px var(--primary-line)}
.nav button.on i{color:var(--primary-text)}
.nav button.on .ic{opacity:1}
.nav button.dim{opacity:.5}
.nav-sep{width:30px;height:1px;background:var(--line);margin:var(--s3) 0}
.side-foot{display:flex;flex-direction:column;gap:6px;align-items:center;width:100%;
  padding-top:var(--s3);border-top:1px solid var(--line)}
.sf-line{display:none}   /* 窄条里放不下项目名，交给标题栏 */

/* ── 顶栏 ────────────────────────────────────────────────── */
.top{
  grid-area:top; display:flex; align-items:center; gap:var(--s4); padding:0 var(--s5);
  background:color-mix(in srgb, var(--surface) 92%, transparent);
  border-bottom:1px solid var(--line);
}
.tinfo{min-width:0;flex:1}
.tinfo h1{margin:0;font-size:var(--fs-xl);font-weight:700;letter-spacing:-.2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.25}
.tinfo p{margin:2px 0 0;font-size:var(--fs-sm);color:var(--muted);font-family:var(--mono);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tactions{display:flex;align-items:center;gap:var(--s2)}

/* ── 右侧诊断栏 ──────────────────────────────────────────── */
.rail{grid-area:rail;display:flex;flex-direction:column;min-width:0;
  background:var(--surface);border-left:1px solid var(--line);overflow:hidden}
body.rail-off .rail{display:none}
.rail-head{display:flex;align-items:center;gap:var(--s2);padding:0 var(--s4);height:var(--top-h);
  border-bottom:1px solid var(--line)}
.rail-head b{font-size:var(--fs-md)}
.rail-head .hint{font-size:var(--fs-sm);color:var(--muted)}
.rail-body{flex:1;overflow:auto;padding:var(--s3) var(--s3) var(--s5)}
/* 全局项目条：选谁，右边整片内容就跟着谁。放在最上层是有意的——
   「我现在在哪个项目里」比任何细节都更该先被回答。 */
.rail-projs{flex:none;max-height:34vh;overflow:auto;padding:var(--s2) var(--s2) var(--s3);
  border-bottom:1px solid var(--line)}
.rail-projs .rp{display:flex;align-items:center;gap:7px;width:100%;text-align:left;
  border:0;background:transparent;cursor:pointer;padding:7px 9px;border-radius:var(--r-sm);
  color:var(--fg-2);font-size:var(--fs-sm);
  transition:background var(--t-fast) var(--ease-soft),color var(--t-fast) var(--ease-soft)}
.rail-projs .rp:hover{background:var(--sunken);color:var(--fg)}
.rail-projs .rp.on{background:var(--primary-soft);color:var(--primary-text);
  box-shadow:inset 2px 0 0 var(--primary);font-weight:650}
.rail-projs .rp .dot{flex:none;width:7px;height:7px;border-radius:50%;
  background:var(--faint);box-shadow:0 0 0 3px var(--inset)}
.rail-projs .rp.on .dot{background:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
.rail-projs .rp .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rail-projs .rp .k{color:var(--faint);font-size:11px;font-family:var(--mono);flex:none}
.rail-projs .rp.on .k{color:var(--primary-text)}
.rail-projs .rp-empty{color:var(--muted);font-size:var(--fs-sm);padding:var(--s2) var(--s1);line-height:1.7}
/* 依赖栏的标题：它属于「当前项目」，所以是第二段，不是主标题 */
.rail-sub{display:flex;align-items:center;gap:var(--s2);flex:none;
  padding:9px var(--s4) 7px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  background:var(--tool-bg);font-size:var(--fs-sm)}
.rail-sub b{font-weight:700;color:var(--fg)}
.rail-sub span{color:var(--muted);font-size:11.5px}
/* 底部工具窗打开时，左栏也要让位——不然下半截被压在下面看不见 */
body.dock-open .rail{padding-bottom:calc(var(--dock-h) + var(--s2))}
.rail-sec{margin:var(--s4) 0 var(--s2);font-size:var(--fs-sm);color:var(--muted);
  display:flex;gap:var(--s2);align-items:baseline}
.rail-empty{color:var(--muted);font-size:var(--fs-sm);padding:var(--s3) var(--s1);line-height:1.7}

.diag{
  border:1px solid var(--line); border-left-width:3px; border-radius:var(--r);
  padding:10px 12px; margin-bottom:var(--s2); background:var(--surface);
  cursor:pointer; box-shadow:var(--shadow-1);
  transition:transform var(--t) var(--ease), box-shadow var(--t) var(--ease), border-color var(--t) var(--ease);
}
.diag:hover{transform:translateY(-1px);box-shadow:var(--shadow-2);border-color:var(--line-2)}
.diag.error{border-left-color:var(--danger-text);background:linear-gradient(90deg,var(--danger-soft),var(--surface) 60%)}
.diag.warn{border-left-color:var(--warn);background:linear-gradient(90deg,var(--warn-soft),var(--surface) 60%)}
.diag.info{border-left-color:var(--line-2)}
.diag .dt{font-size:var(--fs);font-weight:650;line-height:1.5;color:var(--fg)}
.diag .dm{font-size:11.5px;color:var(--faint);margin-top:3px;font-family:var(--mono);
  font-variant-numeric:tabular-nums}

/* 依赖面板：一行一个依赖，左边一个勾/叉 */
/* 依赖工具窗（照 Maven 的读法）：一行一项，中列是「声明 → 实际」。
   行高 22px、名字与版本等宽、状态图标固定宽——这样一列一列对齐，
   眼睛竖着扫就行，不用逐行读句子。 */
.dep-row{display:grid;grid-template-columns:13px minmax(0,1fr) auto;align-items:center;
  gap:8px;height:22px;padding:0 4px;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);
  font-size:var(--fs-sm);color:var(--fg-2)}
.dep-row:hover{background:var(--sunken);color:var(--fg)}
.dep-row .st{text-align:center;font-size:11px;color:var(--ok-text);font-weight:700}
.dep-row.miss .st{color:var(--danger-text)}
.dep-row.unk .st{color:var(--faint)}
.dep-row.unk .vd{color:var(--faint)}
.dep-row .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--mono);
  font-size:12px}
.dep-row .vd{color:var(--faint);font-family:var(--mono);font-size:11px;
  font-variant-numeric:tabular-nums;white-space:nowrap}
.dep-row .vd i{font-style:normal;color:var(--line-2);padding:0 3px}
.dep-row.miss .vd{color:var(--danger-text)}
.rail-sec .cnt{margin-left:auto;font-family:var(--mono);font-size:11px;
  color:var(--muted);font-variant-numeric:tabular-nums}
/* 工具窗自己的工具条：筛选框 + 重载 + 一键补装 */
.rail-tools{display:flex;align-items:center;gap:6px;padding:6px 2px var(--s2)}
.rail-tools input{flex:1;min-width:0;padding:4px 8px;border:1px solid var(--line);
  border-radius:var(--r-xs);background:var(--bg);font-size:11.5px;font-family:var(--font)}
.rail-tools .iconbtn{padding:3px 8px;font-size:11.5px;border:1px solid var(--line);
  border-radius:var(--r-xs);color:var(--muted);background:var(--bg)}
.rail-tools .iconbtn:hover{color:var(--fg);border-color:var(--line-2)}
.rail-tools .iconbtn.hot{color:var(--primary-text);border-color:var(--primary-line);
  background:var(--primary-soft);font-weight:650}
/* 分组头：点一下折叠。有计数，一眼知道还剩几项 */
.dep-grp{display:flex;align-items:center;gap:7px;height:24px;padding:0 4px;cursor:pointer;
  font-size:var(--fs-sm);color:var(--fg-2);background:var(--inset);
  border-bottom:1px solid color-mix(in srgb,var(--line) 60%,transparent)}
.dep-grp:hover{color:var(--fg)}
.dep-grp .chev{width:10px;text-align:center;color:var(--faint);font-size:9px}
.dep-grp b{font-weight:650}
.dep-grp .cnt{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--muted);
  font-variant-numeric:tabular-nums}
.dep-manifest{background:var(--inset);border:1px solid var(--line);border-radius:var(--r-sm);
  padding:8px 10px;margin-bottom:6px}
.dep-manifest b{display:block;font-size:var(--fs-sm);font-family:var(--mono)}
.dep-manifest span{display:block;color:var(--muted);font-size:11.5px;margin-top:2px}

/* 运行时事实行（Node / 前端 与 JVM 两栏共用）：
   "这次会用哪个东西、凭什么"——一行一条"键 → 值"，值靠右对齐，
   和依赖那一栏的"声明 → 实际"同一套读法。凭据走 data-tip（悬停可见），不占常驻视线。 */
.rt-row{display:flex;align-items:baseline;gap:var(--s2);padding:4px 2px;
  font-size:var(--fs-sm);border-bottom:1px solid var(--line)}
.rt-row:last-of-type{border-bottom:0}
.rt-row .k{color:var(--muted);flex:none;min-width:64px}
.rt-row .v{color:var(--fg);font-family:var(--mono);font-size:12px;
  margin-left:auto;text-align:right;word-break:break-all}
.rt-note{margin-top:6px;padding:6px 9px;border-radius:var(--r-sm);background:var(--warn-soft);
  color:var(--fg-2);font-size:11.5px;line-height:1.65}
.dep{display:flex;align-items:center;gap:var(--s2);padding:6px 9px;border-radius:var(--r-sm);
  font-size:var(--fs-sm);font-family:var(--mono);transition:background var(--t) var(--ease)}
.dep:hover{background:var(--sunken)}
.dep .dmark{width:14px;text-align:center;color:var(--ok-text);font-weight:700}
.dep.miss .dmark{color:var(--danger-text)}
.dep.miss .dname{color:var(--danger-text)}
.dep .dname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ── 主区 ────────────────────────────────────────────────── */
main{grid-area:main;overflow:auto;padding:var(--s5) 0 64px}
.view{display:none;max-width:1240px;margin:0 auto;padding:0 var(--s5)}
.view.on{display:block}
.secTitle{margin:var(--s6) 0 var(--s3);font-size:var(--fs-md);font-weight:700;letter-spacing:.2px}

/* ── 通知（右上角，滑入）──────────────────────────────────── */
.feed{position:fixed;right:calc(var(--rail-w) + var(--s4));bottom:52px;
  width:min(360px, calc(100vw - var(--side) - var(--rail-w) - var(--s5)));max-height:34vh;
  overflow:auto;display:flex;flex-direction:column;gap:var(--s2);z-index:60;
  transition:right var(--t-slow) var(--ease)}
.fb{background:var(--surface);border:1px solid var(--line);border-left-width:3px;border-radius:var(--r);
  padding:11px 14px;box-shadow:var(--shadow-3);font-size:var(--fs);animation:slideIn var(--t) var(--ease)}
.fb.block{border-left-color:var(--danger-text);background:linear-gradient(90deg,var(--danger-soft),var(--surface) 55%)}
.fb.warn{border-left-color:var(--warn);background:linear-gradient(90deg,var(--warn-soft),var(--surface) 55%)}
.fb.info{border-left-color:var(--line-2)}
.fb .fbt{font-weight:650;display:flex;gap:var(--s2);align-items:baseline}
.fb .fbt .t{margin-left:auto;color:var(--faint);font-size:11.5px;font-weight:400;font-variant-numeric:tabular-nums}
.fb .fbd{color:var(--fg-2);font-size:var(--fs-sm);margin-top:4px;line-height:1.65;word-break:break-word}
.fb .fbd code{background:var(--inset);padding:1px 5px;border-radius:6px;font-size:12px}
.fb .fbx{cursor:pointer;color:var(--muted);font-size:11.5px;margin-top:6px;user-select:none}
.fb .fbx:hover{color:var(--primary-text)}
.toast{position:fixed;left:50%;bottom:var(--s6);transform:translateX(-50%);
  background:var(--bar-bg);color:var(--bar-fg);padding:11px 20px;border-radius:var(--r);
  font-size:var(--fs);box-shadow:var(--shadow-pop);z-index:80;animation:slideIn var(--t) var(--ease)}
.toast.bad{background:var(--danger);color:#FFF6F2}

/* ── 状态栏 ──────────────────────────────────────────────── */
.bar{grid-area:bar;display:flex;align-items:center;gap:var(--s4);padding:0 var(--s4);
  background:var(--bar-bg);color:var(--bar-fg);font-size:var(--fs-sm);white-space:nowrap}
.bar b{color:#FFF8F1;font-weight:650;font-variant-numeric:tabular-nums}
.bar .bit{display:flex;align-items:center;gap:6px}
.bar .dim{color:var(--bar-dim)}
.bar .btn{background:transparent;border-color:rgba(255,255,255,.18);color:var(--bar-fg)}
.bar .btn:hover{background:rgba(255,255,255,.1)}

/* ── 按钮 ────────────────────────────────────────────────── */
.btn{
  display:inline-flex;align-items:center;gap:7px;justify-content:center;
  border:1px solid var(--primary);background:var(--primary);color:var(--primary-fg);
  padding:8px 15px;border-radius:var(--r-sm);font-weight:650;font-size:var(--fs);
  box-shadow:0 1px 2px rgba(150,80,50,.18);
  transition:transform var(--t-fast) var(--ease),background var(--t) var(--ease),
             box-shadow var(--t) var(--ease),border-color var(--t) var(--ease);
}
.btn:hover{background:var(--primary-hover);box-shadow:0 2px 8px -2px rgba(150,80,50,.35)}
.btn:active{transform:scale(.985)}
.btn:disabled{opacity:.55;cursor:default;transform:none}
.btn.ghost{background:var(--surface);color:var(--fg-2);border-color:var(--line)}
.btn.ghost:hover{background:var(--sunken);border-color:var(--line-2);color:var(--fg)}
.btn.sm{padding:5px 11px;font-size:var(--fs-sm);border-radius:8px}
.btn.big{padding:11px 20px;font-size:var(--fs-md);border-radius:var(--r)}
.btn.caret{padding:8px 9px}
.iconbtn{border:1px solid var(--line);background:var(--surface);color:var(--muted);
  border-radius:8px;width:27px;height:27px;line-height:1;display:grid;place-items:center;
  transition:transform var(--t-fast) var(--ease),color var(--t) var(--ease)}
.iconbtn:hover{color:var(--fg);transform:translateX(1px)}

/* ── 卡片与容器 ──────────────────────────────────────────── */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:var(--s5);box-shadow:var(--shadow-2);margin-bottom:var(--s5)}
.panel h3{margin:0 0 var(--s3);font-size:var(--fs-md)}
.hint{color:var(--muted);font-size:var(--fs-sm);line-height:1.65}
.row{display:flex;gap:var(--s3);flex-wrap:wrap;align-items:center}
.secTitle+.panel{margin-top:var(--s3)}
.more{margin:0 0 var(--s3)}
.more>summary{cursor:pointer;user-select:none;color:var(--muted);font-size:var(--fs-sm);padding:6px var(--s1)}
.more>summary:hover{color:var(--fg)}
.more .facts{margin-top:var(--s3)}

/* 结论卡 */
.status{display:flex;gap:var(--s4);align-items:center;border-radius:var(--r-lg);padding:var(--s5);
  background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow-2);margin-bottom:var(--s4)}
.status .face{width:46px;height:46px;border-radius:var(--r);flex:none;display:grid;place-items:center;font-size:21px}
.status.ok .face{background:var(--ok-soft);color:var(--ok-text)}
.status.warn .face{background:var(--warn-soft);color:var(--warn)}
.status.err .face{background:var(--danger-soft);color:var(--danger-text)}
.status h2{margin:0 0 4px;font-size:var(--fs-lg);font-weight:700;letter-spacing:-.1px}
.status p{margin:0;color:var(--muted);font-size:var(--fs)}

/* **三态的第三支**（`?` 还查不出来）用黄色，不用红色。
   红色是"出错了"，而"我们没查过"不是用户的错——**颜色也在替三态说话**。 */
.status.ask .face{background:var(--warn-soft);color:var(--warn)}

/* ── 一句话指南（`#guideCard`，概览页主位）────────────────────
   它比状态卡多一点东西：下一步能敲的命令、挡路的逐条、以及
   "查不了"时**该谁去补**。那些都需要自己的样式，不然挤成一坨。 */
#guideCard .gd-why{margin-top:6px;color:var(--fg);font-size:var(--fs)}
#guideCard .gd-next{margin-top:10px;display:flex;gap:var(--s2);align-items:baseline}
#guideCard .gd-next b{font-size:var(--fs-sm);color:var(--muted);flex:none}
#guideCard .gd-next code{background:var(--inset);border:1px solid var(--line);
  border-radius:var(--r-sm);padding:2px 7px;font-size:var(--fs-sm);user-select:all}
/* **建议不是命令**（2026-10-18）：未标记但有源码的目录，nextStep 是一句话。 */

/* **"顺便说一句"不是挡路的**（2026-10-18）：比 blockers 轻，但要说。 */
/* **官方链接**（2026-10-18）：缺件那块的下载地址 */
.miss-line a{color:var(--fg);text-decoration:underline;text-underline-offset:2px;}
.miss-line a:hover{opacity:.8;}
#guideCard .gd-nice{margin-top:10px;font-size:var(--fs-sm);color:var(--muted);}
#guideCard .gd-nice ul{margin:4px 0 0 18px;padding:0;}
#guideCard .gd-nice li{margin:2px 0;line-height:1.45;}
#guideCard .gd-next .gd-advice{color:var(--fg);font-size:var(--fs-sm);line-height:1.5;}
#guideCard .gd-blockers{margin-top:10px}
#guideCard .gd-blockers > b{font-size:var(--fs-sm);color:var(--muted)}
#guideCard .gd-b{display:flex;gap:var(--s2);margin-top:6px;align-items:flex-start}
#guideCard .gd-n{flex:none;width:18px;height:18px;border-radius:var(--r-full);background:var(--inset);
  border:1px solid var(--line);display:grid;place-items:center;font-size:11px;color:var(--muted)}
#guideCard .gd-fix{margin-top:2px;color:var(--muted);font-size:var(--fs-sm)}
#guideCard .gd-verify{margin-top:2px;color:var(--muted);font-size:var(--fs-sm)}
#guideCard .gd-verify code{background:var(--inset);border-radius:var(--r-sm);
  padding:1px 5px;user-select:all}

/* 事实网格 */
.facts{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--s3)}
.fact{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:13px 15px}
.fact .k{color:var(--muted);font-size:11.5px;letter-spacing:.3px}
.fact .v{font-size:var(--fs);margin-top:3px;word-break:break-all;font-family:var(--mono);
  font-variant-numeric:tabular-nums;line-height:1.55}

/* 一行小字（项目卡下方那 6 行）*/
.cardNotes{margin:0 0 var(--s4);padding:0 var(--s1)}
.cardNotes .cn{display:flex;gap:var(--s3);align-items:baseline;font-size:var(--fs);line-height:2.05;color:var(--fg-2)}
.cardNotes .cn b{flex:none;width:76px;color:var(--muted);font-weight:500;font-size:var(--fs-sm);text-align:right}
.cardNotes .cn .ok{color:var(--ok-text);font-weight:650}
.cardNotes .cn .bad{color:var(--warn);font-weight:650}

/* 变更卡 */
.chg{background:linear-gradient(180deg,var(--surface),var(--sunken));border:1px solid var(--line);
  border-radius:var(--r-lg);padding:var(--s5);box-shadow:var(--shadow-2);margin-bottom:var(--s5)}
.chg h2{margin:0 0 var(--s2);font-size:var(--fs-md);font-weight:700}
.chg .when{color:var(--muted);font-size:var(--fs-sm);font-weight:400;margin-left:var(--s2);
  font-family:var(--mono);font-variant-numeric:tabular-nums}
.chg ul{margin:var(--s2) 0 0;padding-left:var(--s5);font-size:var(--fs);color:var(--fg-2);line-height:1.95}
.chg .risk{color:var(--warn)}
.chg .fixed{color:var(--ok-text)}

/* ── 诊断条目（主区）────────────────────────────────────── */
.layer{display:flex;gap:var(--s3);align-items:baseline;margin:var(--s5) 0 var(--s2)}
.layer b{font-size:var(--fs);letter-spacing:.2px}
.layer span{color:var(--muted);font-size:var(--fs-sm)}
.finding{background:var(--surface);border:1px solid var(--line);border-left-width:3px;
  border-radius:var(--r);padding:var(--s4) var(--s4);margin-bottom:var(--s3);box-shadow:var(--shadow-1);
  transition:transform var(--t) var(--ease),box-shadow var(--t) var(--ease)}
.finding:hover{transform:translateY(-1px);box-shadow:var(--shadow-2)}
.finding.error{border-left-color:var(--danger-text)}
.finding.warn{border-left-color:var(--warn)}
.finding.info{border-left-color:var(--line-2)}
.finding .ftitle{font-weight:650;font-size:var(--fs-md);display:flex;align-items:baseline;gap:var(--s2);line-height:1.5}
.chip{font-size:11px;padding:2px 8px;border-radius:var(--r-full);font-weight:700;flex:none}
.chip.error{background:var(--danger-soft);color:var(--danger-text)}
.chip.warn{background:var(--warn-soft);color:var(--warn)}
.chip.info{background:var(--inset);color:var(--muted)}
.finding .next{color:var(--primary-text);font-weight:650;font-size:var(--fs);margin-top:var(--s2)}
.finding .boundary{color:var(--muted);font-size:var(--fs-sm);margin-top:2px;line-height:1.65}
.finding details{margin-top:var(--s3)}
.finding summary{cursor:pointer;color:var(--muted);font-size:var(--fs-sm);user-select:none}
.finding summary:hover{color:var(--fg)}
.finding ul{margin:var(--s2) 0 0;padding-left:var(--s5);color:var(--fg-2);font-size:var(--fs-sm);line-height:1.85}
.finding ul code{background:var(--inset);padding:1px 6px;border-radius:6px;font-size:12px;
  font-family:var(--mono);word-break:break-all}

/* 复制块 */
.copy{display:flex;gap:var(--s3);align-items:center;margin-top:var(--s2);background:var(--inset);
  border:1px dashed var(--line-2);border-radius:var(--r-sm);padding:9px 12px;cursor:pointer;
  transition:background var(--t) var(--ease),border-color var(--t) var(--ease)}
.copy:hover{background:var(--sunken);border-color:var(--primary-line)}
.copy code{flex:1;font-size:12.5px;word-break:break-all;color:var(--fg);font-family:var(--mono)}
.copy .cp{color:var(--muted);font-size:11.5px;flex:none}
.copy.done{background:var(--ok-soft);border-color:var(--ok-text)}

/* ── 运行卡 ──────────────────────────────────────────────── */
.runcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  margin-bottom:var(--s3);overflow:hidden;box-shadow:var(--shadow-2);
  transition:box-shadow var(--t) var(--ease),border-color var(--t) var(--ease)}
.runcard.live{border-color:var(--primary-line);box-shadow:0 0 0 3px var(--primary-soft),var(--shadow-2)}
.rc-head{display:flex;align-items:center;gap:var(--s3);padding:11px 16px;cursor:pointer;font-size:var(--fs-sm)}
.rc-head:hover{background:var(--sunken)}
.rc-kind{font-weight:700;color:var(--fg)}
.rc-when{color:var(--faint);font-family:var(--mono);font-variant-numeric:tabular-nums}
.rc-cmd{color:var(--muted);font-family:var(--mono);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pill{font-size:11px;padding:2px 9px;border-radius:var(--r-full);font-weight:700}
.pill.ok{background:var(--ok-soft);color:var(--ok-text)}
.pill.bad{background:var(--danger-soft);color:var(--danger-text)}
.pill.run{background:var(--primary-soft);color:var(--primary-text);animation:breathe 1.6s var(--ease-soft) infinite}
.rc-body{border-top:1px solid var(--line);padding:var(--s4) 18px}
.stages{list-style:none;margin:0;padding:0;font-size:var(--fs-sm)}
.stages li{display:flex;gap:var(--s2);align-items:baseline;padding:3px 0;color:var(--fg-2)}
.stages .st{width:14px;text-align:center;font-weight:700}
.stages .st.ok{color:var(--ok-text)} .stages .st.fail{color:var(--danger-text)} .stages .st.note{color:var(--warn)}
.stages .st.idle{color:var(--line-2)}
.stages .ms{margin-left:auto;color:var(--faint);font-family:var(--mono);font-variant-numeric:tabular-nums}
.verdict{margin-top:var(--s3);padding:11px 14px;border-radius:var(--r)}
.verdict.good{background:var(--ok-soft);border:1px solid color-mix(in srgb,var(--ok) 35%,transparent)}
.verdict.bad{background:var(--danger-soft);border:1px solid color-mix(in srgb,var(--danger) 35%,transparent)}
.verdict.soft{background:var(--warn-soft);border:1px solid color-mix(in srgb,var(--warn) 35%,transparent)}
.verdict .crux{margin-top:4px;font-size:var(--fs-sm);color:var(--fg-2)}
.console{margin-top:var(--s3);background:#2E2823;color:#E8DFD4;border-radius:var(--r-sm);padding:11px 13px;
  font-family:var(--mono);font-size:12px;line-height:1.6;max-height:240px;overflow:auto}
.console .err{color:#F0A08A} .console .log{color:#A7C7D9}

/* ── 项目卡与列表 ────────────────────────────────────────── */
/* 项目用**整行宽横幅**展示：一行一个，信息摊得开，比一排小卡片好读 */
.projList{display:flex;flex-direction:column;gap:var(--s3);margin-top:var(--s4)}
.banner{display:grid;grid-template-columns:minmax(220px,1.1fr) minmax(0,2fr) auto;align-items:center;
  gap:var(--s4);background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:14px var(--s4);box-shadow:var(--shadow-1);cursor:pointer;position:relative;overflow:hidden;
  transition:transform var(--t) var(--ease),box-shadow var(--t) var(--ease),border-color var(--t) var(--ease)}
.banner::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:transparent;
  transition:background var(--t) var(--ease)}
.banner:hover{transform:translateY(-1px);box-shadow:var(--shadow-2);border-color:var(--line-2)}
.banner:hover::before{background:var(--primary-line)}
.banner.on{border-color:var(--primary-line);box-shadow:0 0 0 3px var(--primary-soft),var(--shadow-2)}
.banner.on::before{background:var(--primary)}
.banner .b-name{font-weight:700;font-size:var(--fs-md);display:flex;align-items:baseline;gap:7px}
.banner .b-kind{font-size:11.5px;color:var(--faint);font-family:var(--mono);font-weight:400}
.banner .b-path{color:var(--muted);font-size:11.5px;font-family:var(--mono);margin-top:3px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.banner .b-facts{display:flex;flex-wrap:wrap;gap:var(--s2) var(--s5);font-size:var(--fs-sm);color:var(--fg-2)}
.banner .b-facts .f{display:flex;gap:6px;align-items:baseline;min-width:0}
.banner .b-facts .k{color:var(--muted);font-size:11.5px}
.banner .b-facts .v{font-family:var(--mono);font-variant-numeric:tabular-nums;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.banner .b-acts{display:flex;gap:var(--s2);align-items:center}
.banner .bad{color:var(--warn);font-weight:650}
.banner .ok{color:var(--ok-text);font-weight:650}
/* 骨架文字用正文字体（数字才用等宽），每个字段错开一点点起跑——
   一眼就看得出「它们是一起在算」，而不是一片整齐的假字。 */
.banner .skel{font-family:var(--font);font-size:var(--fs-sm)}
.banner .b-facts .f:nth-child(2) .skel{animation-delay:.12s}
.banner .b-facts .f:nth-child(3) .skel{animation-delay:.24s}
.banner .b-facts .f:nth-child(4) .skel{animation-delay:.36s}
.banner .b-facts .f:nth-child(5) .skel{animation-delay:.48s}
.pcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:17px 18px;
  box-shadow:var(--shadow-1);cursor:pointer;position:relative;overflow:hidden;
  transition:transform var(--t) var(--ease),box-shadow var(--t) var(--ease),border-color var(--t) var(--ease)}
.pcard::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:transparent;
  transition:background var(--t) var(--ease)}
.pcard:hover{transform:translateY(-2px);box-shadow:var(--shadow-3);border-color:var(--line-2)}
.pcard:hover::before{background:var(--primary-line)}
.pcard.on{border-color:var(--primary-line);box-shadow:0 0 0 3px var(--primary-soft),var(--shadow-2)}
.pcard.on::before{background:var(--primary)}
.pcard .pc-name{font-weight:700;font-size:var(--fs-md);display:flex;align-items:baseline;gap:7px;letter-spacing:-.1px}
.pcard .pc-kind{font-size:11.5px;color:var(--faint);font-weight:400;font-family:var(--mono)}
.pcard .pc-note{margin-top:var(--s2);font-size:var(--fs-sm);color:var(--fg-2);line-height:1.8}
.pcard .pc-note b{color:var(--fg)}
.pcard .pc-acts{display:flex;gap:7px;margin-top:var(--s3);flex-wrap:wrap}
.pcard .bad{color:var(--warn);font-weight:650}
.pcard .ok{color:var(--ok-text);font-weight:650}
.projList.compact{grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:var(--s3);margin-top:0}
.projList.compact .pcard{padding:12px 14px}
.pager{display:flex;gap:var(--s3);align-items:center;justify-content:center;margin:var(--s4) 0 var(--s1);
  color:var(--muted);font-size:var(--fs-sm);font-variant-numeric:tabular-nums}

/* 扫描条 */
.scanbar{display:flex;gap:var(--s2);align-items:center;margin:var(--s4) 0 var(--s2);flex-wrap:wrap}
.scanbar input{flex:1;min-width:230px;padding:10px 13px;border:1px solid var(--line);
  border-radius:var(--r-sm);background:var(--surface);font-size:var(--fs);font-family:var(--mono)}
.scanbar select{padding:10px 11px;border:1px solid var(--line);border-radius:var(--r-sm);
  background:var(--surface);font-size:var(--fs-sm)}
input:focus,select:focus,textarea:focus{border-color:var(--primary-text);
  box-shadow:0 0 0 3px var(--primary-soft);outline:none}

/* 附属卡片（项目详情）*/
.projDetail{margin-top:var(--s4);background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r-lg);box-shadow:var(--shadow-3);overflow:hidden;animation:fadeUp var(--t) var(--ease)}
.pd-bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;padding:12px var(--s4);
  background:var(--sunken);border-bottom:1px solid var(--line)}
.pd-bar .pd-title{font-weight:700;font-size:var(--fs-md);margin-right:auto}
.pd-bar button{font-size:var(--fs-sm);padding:6px 12px}
.pd-body{height:320px;overflow:auto;padding:var(--s4) 18px}
.pd-body .pd-sec{margin-bottom:var(--s4)}
.pd-body .pd-k{color:var(--muted);font-size:var(--fs-sm);margin-bottom:6px}
.pd-body .pd-run{color:var(--primary-text);font-weight:700;font-size:var(--fs-md);font-family:var(--mono)}
.pd-body .pd-why{color:var(--muted);font-size:var(--fs-sm);line-height:1.75;margin-top:5px}
.pd-body input{width:100%;padding:9px 12px;border:1px solid var(--line);border-radius:var(--r-sm);
  font-family:var(--mono);font-size:var(--fs);margin-bottom:7px;background:var(--surface)}
.pd-body .row2{display:flex;gap:var(--s2);align-items:center}

/* ── 项目体检 ────────────────────────────────────────────── */
.audit-head{display:flex;align-items:baseline;gap:var(--s3);margin-top:var(--s6)}
.audit-head .secTitle{margin:0}
.audit-sum{margin:var(--s2) 0 var(--s3);color:var(--muted);font-size:var(--fs-sm);line-height:1.7}
.amans{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:var(--s3)}
.aman{background:var(--inset);border:1px solid var(--line);border-radius:var(--r-sm);padding:5px 10px;
  font-size:var(--fs-sm);color:var(--fg-2);font-family:var(--mono)}
.aman b{color:var(--fg)}
.agroup{margin-bottom:var(--s2)}
.agroup>summary{cursor:pointer;user-select:none;font-weight:650;font-size:var(--fs);
  padding:11px var(--s3);background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r);transition:background var(--t) var(--ease)}
.agroup>summary:hover{background:var(--sunken)}
.agroup>summary .n{color:var(--muted);font-weight:400;font-size:var(--fs-sm);margin-left:7px}
.agroup[open]>summary{border-radius:var(--r) var(--r) 0 0;border-bottom-color:transparent}
.agroup .aitems{border:1px solid var(--line);border-top:none;border-radius:0 0 var(--r) var(--r);
  padding:var(--s3);background:var(--sunken)}
.ai{background:var(--surface);border:1px solid var(--line);border-left-width:3px;border-radius:var(--r-sm);
  padding:10px 13px;margin-bottom:7px}
.ai.error{border-left-color:var(--danger-text)}
.ai.warn{border-left-color:var(--warn)}
.ai.info{border-left-color:var(--line-2)}
.ai>summary{cursor:pointer;user-select:none;display:flex;align-items:baseline;gap:var(--s2);font-size:var(--fs)}
.ai>summary .aid{margin-left:auto;color:var(--faint);font-size:11.5px;font-family:var(--mono)}
.ai .aibody{padding-top:9px;font-size:var(--fs-sm);color:var(--fg-2);line-height:1.75}
.ai .aibody .lbl{color:var(--muted);font-size:11.5px;margin-top:8px;letter-spacing:.3px}
.ai .aibody ul{margin:4px 0 0;padding-left:18px}
.ai .aibody .nx{color:var(--primary-text);font-weight:650;margin-top:5px}
.afix{display:flex;align-items:center;gap:var(--s3);flex-wrap:wrap;margin-top:7px}
.afix span{color:var(--muted);font-size:var(--fs-sm)}

/* ── 清理 ────────────────────────────────────────────────── */
.zone{margin-bottom:var(--s5)}
.zone h3{margin:0 0 7px;font-size:var(--fs-md)}
.zhint{color:var(--muted);font-size:var(--fs-sm);margin-bottom:var(--s3);line-height:1.7}
.item{display:flex;gap:var(--s3);align-items:flex-start;background:var(--surface);
  border:1px solid var(--line);border-radius:var(--r);padding:13px 15px;margin-bottom:7px;
  transition:transform var(--t) var(--ease),box-shadow var(--t) var(--ease)}
.item:hover{transform:translateY(-1px);box-shadow:var(--shadow-2)}
.item input[type=checkbox]{margin-top:4px;width:16px;height:16px;accent-color:var(--primary-text);flex:none}
.item .body{flex:1;min-width:0}
.item .l1{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.item .label{font-weight:650}
.item .size{margin-left:auto;color:var(--muted);font-size:var(--fs-sm);font-family:var(--mono);
  font-variant-numeric:tabular-nums}
.item .path{color:var(--faint);font-size:11.5px;word-break:break-all;font-family:var(--mono);margin-top:2px}
.item .why{font-size:var(--fs-sm);margin-top:5px;color:var(--fg-2)}
.item .cost{font-size:var(--fs-sm);color:var(--muted);margin-top:3px}
.tag{font-size:11px;padding:2px 8px;border-radius:var(--r-full);background:var(--inset);color:var(--muted)}
.tag.cmd{background:var(--info-soft);color:var(--info)}
.noTouch .item{border-left:3px solid var(--line-2);background:var(--sunken)}

/* ── 记录（笔记/运行/变更）──────────────────────────────── */
.noteTop{margin-bottom:var(--s5)}
.noteTop-bar{display:flex;align-items:baseline;gap:var(--s3);margin-bottom:var(--s3)}
.noteTop-bar b{font-size:var(--fs-md)}
.notebook{display:grid;grid-template-columns:328px 1fr;gap:var(--s4);height:calc(100vh - 230px);min-height:420px}
.nb-list,.nb-editor{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  box-shadow:var(--shadow-2);overflow:hidden;display:flex;flex-direction:column}
.nb-tools{display:flex;gap:var(--s2);padding:var(--s3);border-bottom:1px solid var(--line)}
.nb-tools input{flex:1;padding:8px 11px;border:1px solid var(--line);border-radius:var(--r-sm);background:var(--bg)}
.nb-items{flex:1;overflow:auto;padding:var(--s2)}
.nb-sec{margin-bottom:var(--s3)}
.nb-sec .h{font-size:11.5px;color:var(--muted);margin:var(--s2) 6px 6px;display:flex;gap:var(--s2);
  align-items:baseline;letter-spacing:.3px}
.nb-item{border:1px solid transparent;border-radius:var(--r-sm);padding:9px 11px;cursor:pointer;
  transition:background var(--t) var(--ease),border-color var(--t) var(--ease)}
.nb-item:hover{background:var(--sunken);border-color:var(--line)}
.nb-item.on{background:var(--primary-soft);border-color:var(--primary-line)}
.nb-item .t{font-size:var(--fs);font-weight:600;line-height:1.5}
.nb-item .m{display:flex;gap:var(--s2);flex-wrap:wrap;color:var(--faint);font-size:11.5px;margin-top:3px;
  font-family:var(--mono);font-variant-numeric:tabular-nums}
.nb-item .m b{color:var(--primary-text);font-weight:650}
.nb-foot{padding:9px var(--s3);border-top:1px solid var(--line);color:var(--muted);font-size:11.5px}
.nb-foot .mono{word-break:break-all}
.nb-editor{overflow:auto}
.nb-empty{padding:var(--s6);color:var(--muted);line-height:1.9}
.nb-empty h3{color:var(--fg);margin:0 0 var(--s2)}
.wikilink{background:var(--primary-soft);color:var(--primary-text);border-radius:var(--r-full);
  padding:1px 9px;font-size:var(--fs-sm);cursor:pointer}
.run-ref{cursor:pointer;color:var(--primary-text);font-size:11.5px}

/* ── 这台机器 ────────────────────────────────────────────── */
.deep-head{display:flex;align-items:baseline;gap:var(--s3);margin-bottom:var(--s3)}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:var(--s3);margin-top:var(--s3)}

/* ── 设置 ────────────────────────────────────────────────── */
.chk{display:flex;gap:10px;align-items:flex-start;margin:9px 0;font-size:var(--fs)}
.chk input{margin-top:3px;width:16px;height:16px;accent-color:var(--primary-text)}
.setrow{display:flex;gap:var(--s4);flex-wrap:wrap;margin:var(--s4) 0 var(--s2)}
.setrow label{display:flex;gap:var(--s2);align-items:center;font-size:var(--fs-sm);color:var(--fg-2)}
.setrow select{padding:6px 9px;border:1px solid var(--line);border-radius:var(--r-sm);
  background:var(--surface);font-size:var(--fs-sm)}
.setGroup{margin:var(--s5) 0 var(--s2);padding-top:var(--s3);border-top:1px solid var(--line);
  font-size:11.5px;letter-spacing:.6px;color:var(--muted);text-transform:uppercase}
.setGroup:first-of-type{border-top:0;margin-top:var(--s3)}
.fatal{margin:0 var(--s5) var(--s4);padding:13px 16px;border-radius:var(--r);background:var(--danger-soft);
  border:1px solid color-mix(in srgb,var(--danger) 45%,transparent);color:var(--fg);
  font-size:var(--fs);font-family:var(--mono);word-break:break-all}

/* ── 底部活动带 ──────────────────────────────────────────── */
.band{grid-area:band;background:var(--surface);border-top:1px solid var(--line);
  padding:9px var(--s5) 11px;animation:fadeUp var(--t) var(--ease)}
.band-main{display:flex;align-items:center;gap:var(--s3);font-size:var(--fs)}
.band .hint{color:var(--muted);font-size:var(--fs-sm)}
.band .dot{width:9px;height:9px;border-radius:50%;background:var(--line-2);flex:none;
  transition:background var(--t) var(--ease)}
.band.run .dot{background:var(--primary);animation:pulse 1.4s var(--ease-soft) infinite}
.band.ok .dot{background:var(--ok)}
.band.bad .dot{background:var(--danger)}
.band-stages{display:flex;gap:var(--s4);list-style:none;margin:8px 0 0;padding:0;
  font-size:var(--fs-sm);color:var(--muted);flex-wrap:wrap}
.band-stages li{display:flex;gap:5px;align-items:baseline;font-variant-numeric:tabular-nums}
.band-stages li.ok{color:var(--ok-text)}
.band-stages li.fail{color:var(--danger-text)}
.band-stages li.now{color:var(--primary-text);font-weight:650}

/* ── 菜单 ────────────────────────────────────────────────── */
.menu{position:absolute;top:calc(100% + 6px);background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r);box-shadow:var(--shadow-pop);padding:6px;z-index:70;animation:fadeUp var(--t-fast) var(--ease)}
.switcher{position:relative}
.switcher .menu{right:0;left:auto;min-width:280px;max-height:52vh;overflow:auto}
.switcher .menu button{display:block;width:100%;text-align:left;border:0;background:transparent;
  padding:8px 11px;border-radius:var(--r-sm);font:inherit;cursor:pointer;color:var(--fg)}
.switcher .menu button:hover{background:var(--sunken)}
.switcher .menu button small{display:block;color:var(--faint);font-size:11px;font-family:var(--mono);margin-top:2px}

/* ── 骨架 / 转圈 ─────────────────────────────────────────── */
.spin{display:inline-block;width:10px;height:10px;border:2px solid var(--line-2);
  border-top-color:var(--primary-text);border-radius:50%;animation:spin .7s linear infinite;vertical-align:-1px}
.skel{animation:shimmer 1.1s var(--ease-soft) infinite alternate;color:var(--muted)}
/* 自动流程的进度线：一条细流光 + 一句人话。
   只换文字、不换节点——看着是"稳稳地在动"，而不是一跳一跳。
   做其它动效时记住这条：重挂节点 = 重放动画 = 一次闪。 */
.autoLine{display:flex;align-items:center;gap:10px;margin:0 0 var(--s3);
  padding:9px 13px;border-radius:var(--r);background:var(--inset);
  border:1px solid var(--line);font-size:var(--fs-sm);color:var(--fg-2)}
.autoLine .al-bar{flex:none;width:68px;height:3px;border-radius:99px;
  background:linear-gradient(90deg,transparent,var(--primary),transparent);
  background-size:200% 100%;animation:alFlow 1.5s linear infinite}
.autoLine .al-t{flex:1;min-width:0}
.autoLine[data-kind="ok"] .al-bar{background:var(--ok);animation:none;width:22px}
.autoLine[data-kind="bad"] .al-bar{background:var(--danger);animation:none;width:22px}
.autoLine[data-kind="ok"]{color:var(--ok-text);border-color:color-mix(in srgb,var(--ok) 32%,transparent)}
.autoLine[data-kind="bad"]{color:var(--danger-text);border-color:color-mix(in srgb,var(--danger) 32%,transparent)}
@keyframes alFlow{from{background-position:200% 0}to{background-position:-200% 0}}
/* 忙碌时：光标变「进行中」，外加一个跟着指针的小圈。
   桌面软件的常识——点了按钮总得有点动静，不然会怀疑自己没点到。 */
body.busy,body.busy .ed-node,body.busy button,body.busy .banner{cursor:progress}
.busyCursor{position:fixed;z-index:200;left:0;top:0;pointer-events:none;
  width:18px;height:18px;margin:-9px 0 0 -9px}
.busyCursor .bc-i{display:block;width:100%;height:100%;border-radius:50%;
  border:2px solid color-mix(in srgb,var(--primary) 30%,transparent);
  border-top-color:var(--primary);animation:bcSpin .7s linear infinite}
@keyframes bcSpin{to{transform:rotate(360deg)}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── 动效（只动 transform / opacity）────────────────────── */
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes slideIn{from{opacity:0;transform:translate(14px,0)}to{opacity:1;transform:none}}
@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.35);opacity:.55}}
@keyframes breathe{0%,100%{opacity:.75}50%{opacity:1}}
@keyframes shimmer{from{opacity:.45}to{opacity:.95}}
.view.on{animation:fadeUp var(--t) var(--ease)}
.pcard,.finding,.nb-item,.agroup,.ai,.chg,.panel,.status{animation:fadeUp var(--t) var(--ease)}
.diag.isnew{animation:fadeUp var(--t) var(--ease),flash var(--t-slow) var(--ease)}
@keyframes flash{from{box-shadow:0 0 0 0 var(--primary-soft)}to{box-shadow:0 0 0 8px transparent}}

/* 窄窗口：诊断栏先收窄，再低于 940px 才让位（之前 1080 就藏，导致高 DPI 下直接没了） */
@media (max-width:1280px){ body{ --rail-w:296px } }
@media (max-width:1040px){ body{ --rail-w:264px } }
@media (max-width:940px){ body{ --rail-w:0px } .rail{display:none} }

/* ============================================================================
   跑起来的样子（借鉴 MC 整合包的加载页）：
   逐条亮起的阶段 + 会呼吸的进度 + 旋转的小提示 + 完成时的一下落定
   ========================================================================= */

/* 环境光：极低成本的暖色微动，只动 transform（GPU 合成），不抢注意力 */
.ambient{position:fixed;inset:-20%;z-index:-1;pointer-events:none;opacity:.55;
  background:
    radial-gradient(38vmax 30vmax at 12% 8%, rgba(228,168,120,.20), transparent 62%),
    radial-gradient(34vmax 28vmax at 88% 4%, rgba(196,132,168,.12), transparent 60%),
    radial-gradient(42vmax 34vmax at 74% 96%, rgba(170,196,150,.16), transparent 64%);
  animation:drift 38s var(--ease-soft) infinite alternate}
@keyframes drift{
  from{transform:translate3d(-1.2%,-1%,0) scale(1.02)}
  to{transform:translate3d(1.4%,1.2%,0) scale(1.06)}
}

/* 进度条：底槽 + 呼吸的填充 + 跑动时的扫光 */
.progress{position:relative;height:8px;border-radius:99px;background:var(--inset);overflow:hidden;
  box-shadow:inset 0 1px 2px rgba(96,72,48,.10)}
.progress .fill{height:100%;width:100%;border-radius:99px;
  background:linear-gradient(90deg,var(--primary),#D98A63 60%,#E6A57C);
  box-shadow:0 0 10px -1px rgba(191,91,56,.55);
  /* 用 scaleX 而不是 width：进度是每秒要更新好几次的东西，
     动 width 会反复触发 layout，而动 transform 只走合成层。 */
  transform-origin:left; transform:scaleX(var(--p,0));
  transition:transform var(--t-slow) var(--ease-soft)}
.progress .fill::after{content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);
  transform:translateX(-100%);animation:sweep 1.6s var(--ease-soft) infinite}
@keyframes sweep{to{transform:translateX(100%)}}
.progress.pulse{animation:breathe 1.5s var(--ease-soft) infinite}

/* 阶段列表：逐条亮起（MC 的 "Loading 3/7 …"）*/
.steps{list-style:none;margin:var(--s3) 0 0;padding:0;font-size:var(--fs-sm)}
.steps li{display:flex;gap:var(--s2);align-items:baseline;padding:5px 0;color:var(--muted);
  opacity:.5;transition:opacity var(--t) var(--ease),color var(--t) var(--ease),transform var(--t) var(--ease)}
.steps li.done,.steps li.now{opacity:1}
.steps li.now{color:var(--fg);transform:translateX(2px)}
.steps li .mk{width:14px;text-align:center;font-weight:700;color:var(--line-2)}
.steps li.done .mk{color:var(--ok-text)}
.steps li.fail .mk{color:var(--danger-text)}
.steps li.now .mk{color:var(--primary-text);animation:pulse 1.2s var(--ease-soft) infinite}
.steps li .ms{margin-left:auto;color:var(--faint);font-family:var(--mono);font-variant-numeric:tabular-nums}

/* 启动浮层：居中卡片 + 会呼吸的标记 + 旋转提示（Splash）*/
.launch{position:fixed;inset:0;z-index:70;display:grid;place-items:center;
  background:color-mix(in srgb, var(--bg) 72%, transparent);backdrop-filter:blur(3px);
  animation:fadeIn var(--t) var(--ease)}
.launch.out{animation:fadeOut var(--t-slow) var(--ease) forwards}
.launch .lcard{width:min(520px,86vw);background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r-xl);box-shadow:var(--shadow-pop);padding:var(--s6);
  animation:riseIn var(--t-slow) var(--ease)}
.launch .lhead{display:flex;align-items:center;gap:var(--s3);margin-bottom:var(--s4)}
.launch .lmark{width:38px;height:38px;border-radius:var(--r-sm);flex:none;
  background:linear-gradient(150deg,var(--primary),#A9482A);
  box-shadow:0 3px 14px -4px rgba(191,91,56,.6);animation:breathe 1.8s var(--ease-soft) infinite}
.launch h2{margin:0;font-size:var(--fs-lg);font-weight:700}
.launch .lsub{color:var(--muted);font-size:var(--fs-sm);margin-top:2px}
.launch .ltip{margin-top:var(--s4);padding:11px 14px;border-radius:var(--r);background:var(--inset);
  color:var(--fg-2);font-size:var(--fs-sm);line-height:1.7;min-height:44px;
  transition:opacity var(--t) var(--ease)}
.launch .lfoot{display:flex;gap:var(--s3);align-items:center;margin-top:var(--s4)}

/* 完成时的一下"落定"：卡片轻弹 + 一圈扩散的暖光 */
.settle{animation:settle var(--t-slow) var(--ease-soft)}
@keyframes settle{0%{transform:scale(.985)}60%{transform:scale(1.008)}100%{transform:scale(1)}}
.ripple{position:relative;overflow:hidden}
.ripple::after{content:"";position:absolute;left:50%;top:50%;width:8px;height:8px;border-radius:50%;
  background:radial-gradient(circle, var(--primary-soft), transparent 70%);opacity:0;
  transform:translate(-50%,-50%) scale(1)}
.ripple.go::after{animation:ripple .5s var(--ease-soft)}
@keyframes ripple{from{opacity:.9;transform:translate(-50%,-50%) scale(1)}to{opacity:0;transform:translate(-50%,-50%) scale(34)}}

/* 表格/列表插入时的错落淡入（JS 给 style="--i:n"）*/
.stagger{animation:fadeUp var(--t) var(--ease) backwards;animation-delay:calc(var(--i, 0) * 38ms)}

@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes fadeOut{to{opacity:0}}
@keyframes riseIn{from{opacity:0;transform:translateY(10px) scale(.985)}to{opacity:1;transform:none}}

/* 按钮：按下有回弹，hover 有一点点浮起（功能性反馈，不是装饰）*/
.btn{will-change:transform}
.btn:hover{transform:translateY(-1px)}
.btn:active{transform:translateY(0) scale(.985)}

/* 勾选/开关：选中时来一下小小的确认感 */
.chk input:checked{animation:settle var(--t) var(--ease-soft)}

/* ── 点击反馈：涟漪落在指针位置（MC 的"按下去有回应"）──────── */
.ripple{position:relative;overflow:hidden;isolation:isolate}
.ripple::after{content:"";position:absolute;left:var(--rx,50%);top:var(--ry,50%);
  width:10px;height:10px;border-radius:50%;opacity:0;pointer-events:none;
  background:radial-gradient(circle, color-mix(in srgb,var(--primary) 42%,transparent), transparent 70%);
  transform:translate(-50%,-50%) scale(1)}
.ripple.go::after{animation:ripple .52s var(--ease-soft)}
@keyframes ripple{
  from{opacity:.85;transform:translate(-50%,-50%) scale(1)}
  to{opacity:0;transform:translate(-50%,-50%) scale(28)}
}

/* 键盘焦点环：只用键盘时看得见，用鼠标时不出来打扰 */
:focus{outline:none}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px;border-radius:var(--r-sm)}

/* 提示轮播：每条弹入时带一点 MC splash 的俏皮（小幅回弹，绝不夸张）*/
.ltip span.tipin{display:inline-block;animation:tipIn var(--t-slow) var(--ease-soft)}
@keyframes tipIn{0%{opacity:0;transform:translateY(4px) rotate(-1.2deg) scale(.98)}
  60%{opacity:1;transform:translateY(0) rotate(.4deg) scale(1.012)}
  100%{transform:none}}

/* 数字变化时跳一下（计数、体积、耗时都用得上）*/
.num{display:inline-block;font-variant-numeric:tabular-nums}
.num.pop{animation:numPop var(--t-slow) var(--ease-soft)}
@keyframes numPop{0%{transform:translateY(0)}35%{transform:translateY(-2px) scale(1.06)}100%{transform:none}}

/* 进度到 100%：条子收束 + 一圈暖光（完成的那一下"落定"）*/
.progress.full .fill{box-shadow:0 0 14px 0 rgba(191,91,56,.5)}
.progress.full::after{content:"";position:absolute;inset:-3px;border-radius:99px;
  border:1px solid var(--primary);opacity:0;animation:ringOut .6s var(--ease-soft)}
@keyframes ringOut{from{opacity:.7;transform:scale(.99)}to{opacity:0;transform:scale(1.04)}}

/* 阶段打勾：勾是"画"出来的 */
.steps li.done .mk{animation:checkDraw .32s var(--ease-soft)}
@keyframes checkDraw{0%{opacity:0;transform:scale(.6) rotate(-12deg)}100%{opacity:1;transform:none}}

/* 悬停高亮：列表行（MC 物品格的选中感），只改背景与描边，不动布局 */
.item:hover,.nb-item:hover,.diag:hover,.pcard:hover{border-color:var(--line-2)}

/* 声音开关在设置里，默认开但很轻（见 app.js 的 sfx）*/

/* ============================================================================
   从 MC 生态里做得最好的那批 UI 借来的：
   成就弹窗的滑入+扫光、Sodium 式设置行与胶囊开关、EMI 式即时过滤、Modern UI 的面板进场
   ========================================================================= */

/* 通知：成就弹窗那套（右侧滑入 → 扫光 → 停住）；图标块像成就图标 */
.fb{position:relative;overflow:hidden;padding-left:56px}
.fb::before{content:attr(data-icon);position:absolute;left:12px;top:11px;
  width:32px;height:32px;border-radius:9px;display:grid;place-items:center;
  font-size:15px;font-weight:700;background:var(--inset);color:var(--muted)}
.fb.block::before{background:var(--danger-soft);color:var(--danger-text)}
.fb.warn::before{background:var(--warn-soft);color:var(--warn)}
.fb.info::before{background:var(--ok-soft);color:var(--ok-text)}
.fb::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(105deg,transparent 32%,rgba(255,255,255,.45) 46%,transparent 60%);
  transform:translateX(-120%);animation:shine 1.15s var(--ease-soft) .12s 1}
@keyframes shine{to{transform:translateX(120%)}}

/* 设置：Sodium 式行（标签左、开关右、一行解释、整行悬停高亮）*/
.opt{display:flex;align-items:center;gap:var(--s4);padding:11px var(--s3);border-radius:var(--r);
  transition:background var(--t) var(--ease)}
.opt:hover{background:var(--sunken)}
.opt .lbl{flex:1;min-width:0}
.opt .lbl b{display:block;font-weight:650;font-size:var(--fs)}
.opt .lbl span{display:block;color:var(--muted);font-size:var(--fs-sm);line-height:1.6;margin-top:2px}
/* 胶囊开关 */
.opt input.sw{appearance:none;flex:none;width:40px;height:23px;border-radius:99px;
  background:var(--line-2);position:relative;cursor:pointer;border:0;
  transition:background var(--t) var(--ease)}
.opt input.sw::after{content:"";position:absolute;top:3px;left:3px;width:17px;height:17px;border-radius:50%;
  background:var(--surface);box-shadow:0 1px 2px rgba(96,72,48,.25);
  transition:transform var(--t) var(--ease)}
.opt input.sw:checked{background:var(--primary)}
.opt input.sw:checked::after{transform:translateX(17px)}
.opt input.sw:focus-visible{outline:2px solid var(--primary);outline-offset:2px}

/* 悬浮提示：延迟出现，深色半透明 + 1px 亮边 + 等宽（MC 的 tooltip 质感）*/
.tip{position:fixed;z-index:200;max-width:340px;padding:8px 11px;border-radius:10px;
  background:color-mix(in srgb, var(--bar-bg) 94%, transparent);color:var(--bar-fg);
  border:1px solid rgba(255,255,255,.16);box-shadow:var(--shadow-pop);
  font-size:12.5px;line-height:1.6;pointer-events:none;opacity:0;transform:translateY(3px);
  transition:opacity var(--t-fast) var(--ease),transform var(--t-fast) var(--ease)}
.tip.on{opacity:1;transform:none}
.tip .tk{color:var(--bar-dim);font-size:11px}

/* EMI 式：搜索即过滤，结果错落淡入 */
.filtered{animation:fadeUp var(--t) var(--ease) backwards;animation-delay:calc(var(--i,0) * 26ms)}

/* ============================================================================
   鼠标动效（从 MC 及其最好的那批 mod 里学的，全部只动 transform/opacity）
   ========================================================================= */

/* 一条龙流水线：装依赖 → 构建 → 测试 → 运行；每步状态灯 */
.pipeline{display:flex;align-items:center;gap:var(--s2);flex-wrap:wrap;
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:var(--s3) var(--s4);box-shadow:var(--shadow-2);margin-bottom:var(--s4)}
.parrow{color:var(--line-2);font-size:13px;flex:none}
.pstep{display:flex;align-items:center;gap:var(--s2);border:1px solid var(--line);
  background:var(--sunken);border-radius:var(--r);padding:9px 13px;text-align:left;
  transition:transform var(--t) var(--ease),border-color var(--t) var(--ease),background var(--t) var(--ease)}
.pstep:hover{transform:translateY(-1px);border-color:var(--line-2);background:var(--surface)}
.pstep b{font-weight:650;font-size:var(--fs)}
.pstep .pcmd{color:var(--faint);font-size:11.5px;font-family:var(--mono);max-width:190px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pstep .pdot{width:9px;height:9px;border-radius:50%;background:var(--line-2);flex:none;
  transition:background var(--t) var(--ease),transform var(--t) var(--ease)}
.pstep.primary{border-color:var(--primary-line);background:var(--primary-soft)}
.pstep.done .pdot{background:var(--ok);animation:settle var(--t) var(--ease-soft)}
.pstep.fail .pdot{background:var(--danger)}
.pstep.busy .pdot{background:var(--primary);animation:pulse 1.2s var(--ease-soft) infinite}
.pstep.none{opacity:.55}

/* ── 编辑器（工作副本）────────────────────────────────────── */
.hero-art{width:104px;height:104px;margin:0 auto var(--s3);display:block;
  fill:none;stroke:var(--line-2);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.hero-art circle{fill:var(--primary);stroke:none}
.welcome{text-align:center}
.welcome h2{font-size:var(--fs-xl);letter-spacing:-.2px;margin:0 0 var(--s2)}
.welcome>p{color:var(--muted);margin:0 auto var(--s4);max-width:520px;line-height:1.8}
.welcome .scanbar,.welcome .projList,.welcome .pager,.welcome .projDetail{text-align:left}
/* 编辑器这一页是「画布」，不是卡片。
   结构树是工具窗（平的一块），代码区是画布（平的一块），中间一条发丝线；
   圆角、描边、阴影留给浮在上面的东西——查找栏、提示条、四角的通知。
   把工作区也做成卡片，就等于给「能在上面叠东西」这件事先砌了一圈墙。 */
#view-editor{max-width:none;padding:0}
.ed-wrap{display:grid;grid-template-columns:262px minmax(0,1fr);gap:0;
  height:calc(100vh - var(--top-h) - var(--bar-h));min-height:420px;
  border-top:1px solid var(--line)}
body.dock-open .ed-wrap{height:calc(100vh - var(--top-h) - var(--bar-h) - var(--dock-h))}
.ed-side,.ed-main{display:flex;flex-direction:column;overflow:hidden;
  border:0;border-radius:0;box-shadow:none}
.ed-side{background:var(--tool-bg);border-right:1px solid var(--line)}
.ed-main{background:var(--bg)}
.ed-tools{display:flex;gap:var(--s2);padding:var(--s3);border-bottom:1px solid var(--line)}
.ed-tools input{flex:1;padding:8px 11px;border:1px solid var(--line);border-radius:var(--r-sm);
  background:var(--bg);font-size:var(--fs-sm)}
.ed-files{flex:1;overflow:auto;padding:var(--s2)}
/* 项目树（照 IDEA 的项目视图来）：缩进靠 --d 一层层推；箭头 + 类型点 + 名字。
   类型点的颜色不是装饰——扫一眼就知道这个目录是用什么写的，翻找时不用逐个读后缀。 */
.ed-node{display:flex;align-items:center;gap:7px;height:25px;cursor:pointer;
  padding:0 var(--s2) 0 calc(var(--s2) + var(--d,0) * 15px);
  font-size:var(--fs-sm);color:var(--fg-2);white-space:nowrap;
  transition:background var(--t-fast) var(--ease-soft),color var(--t-fast) var(--ease-soft)}
.ed-node:hover{background:var(--sunken);color:var(--fg)}
.ed-node.on{background:var(--primary-soft);color:var(--primary-text);box-shadow:inset 2px 0 0 var(--primary)}
.ed-node .chev{flex:none;width:11px;text-align:center;color:var(--faint);font-size:9px;line-height:1}
.ed-node .nm{overflow:hidden;text-overflow:ellipsis;font-family:var(--mono)}
.ed-node.dir .nm{font-family:var(--font);font-weight:600;color:var(--fg)}
.ed-node.dir.open .nm{color:var(--fg)}
.ed-node .cnt{flex:none;margin-left:auto;color:var(--faint);font-size:11px;
  font-variant-numeric:tabular-nums}
.ed-node .ico{flex:none;width:8px;height:8px;border-radius:2px;background:var(--faint)}
.ed-node .ico.d{width:11px;height:8px;border-radius:2px 2px 1px 1px}
.ed-node.dir.open .ico.d{background:var(--primary-text)}
.ed-node .ico.rs{background:#c9803f}
.ed-node .ico.py{background:#4b7ea8}
.ed-node .ico.js{background:#c9a227}
.ed-node .ico.jv{background:#c06a4a}
.ed-node .ico.cc{background:#6f8fb5}
.ed-node .ico.cf{background:#9a8f7a}
.ed-node .ico.md{background:#7f9e6b}
.ed-bar{display:flex;align-items:center;gap:var(--s2);padding:0 var(--s3);min-height:38px;
  border-bottom:1px solid var(--line);background:var(--sunken)}
.ed-bar b{font-size:var(--fs-sm);font-family:var(--mono);font-weight:650}
.ed-bar .dirty{font-size:11.5px;color:var(--warn);background:var(--warn-soft);
  padding:1px 8px;border-radius:99px;font-weight:700}
.ed-body{flex:1;display:flex;min-height:0;background:var(--bg)}
.ed-gutter{flex:none;padding:14px 8px 14px 12px;text-align:right;color:var(--faint);
  font-family:var(--mono);font-size:12.5px;line-height:20px;user-select:none;
  background:var(--sunken);border-right:1px solid var(--line);overflow:hidden}
/* 语法高亮的做法：底下铺一层 <pre>，上面盖一个"字透明、光标可见"的 textarea。
   不用引任何库，也不牺牲输入体验（滚动/换行都与 textarea 保持一致）。 */
.ed-wrap2{position:relative;flex:1;min-width:0;overflow:hidden}
/* 高亮层现在只画可见窗口，纵向位置由 JS 用 transform 推——
   所以它的 padding-top 归 0，顶部留白改由占位块负责。 */
.ed-code{position:absolute;inset:0;margin:0;padding:0 16px;overflow:hidden;will-change:transform;
  font-family:var(--mono);font-size:12.5px;line-height:20px;white-space:pre;tab-size:4;
  color:var(--fg);pointer-events:none}
.ed-body textarea{position:relative;width:100%;height:100%;border:0;outline:none;resize:none;padding:14px 16px;
  font-family:var(--mono);font-size:12.5px;line-height:20px;background:transparent;color:var(--fg);
  tab-size:4}
.ed-body textarea{color:transparent;caret-color:var(--fg)}
.ed-body textarea::selection{background:color-mix(in srgb,var(--primary) 28%,transparent)}
/* 取自 IDEA 的两套配色（浅：IDEA Light / 暗：Darcula） */
:root{ --sy-kw:#0033b3; --sy-str:#067d17; --sy-com:#8c8c8c; --sy-num:#1750eb; --sy-fn:#00627a; --sy-typ:#000000 }
[data-theme="dark"]{ --sy-kw:#cc7832; --sy-str:#6a8759; --sy-com:#808080; --sy-num:#6897bb; --sy-fn:#ffc66d; --sy-typ:#a9b7c6 }
.sy-kw{color:var(--sy-kw);font-weight:600}
.sy-str{color:var(--sy-str)}
.sy-com{color:var(--sy-com);font-style:italic}
.sy-num{color:var(--sy-num)}
.sy-fn{color:var(--sy-fn)}
.sy-typ{color:var(--sy-typ)}
.ed-foot{padding:7px var(--s3);border-top:1px solid var(--line);color:var(--muted);
  font-size:11.5px;font-family:var(--mono);font-variant-numeric:tabular-nums}
.ed-menu{position:absolute;z-index:80;background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r);box-shadow:var(--shadow-pop);padding:6px;max-height:44vh;overflow:auto}
.ed-menu button{display:block;width:100%;text-align:left;border:0;background:transparent;
  padding:7px 10px;border-radius:var(--r-sm);font-size:var(--fs-sm);font-family:var(--mono);cursor:pointer}
.ed-menu button:hover{background:var(--sunken)}
.ed-dirtybar{display:flex;gap:var(--s2);align-items:center;flex-wrap:wrap;
  margin:0 0 var(--s2);padding:8px 10px;border-radius:var(--r-sm);
  background:var(--warn-soft);border:1px solid color-mix(in srgb,var(--warn) 35%,transparent);
  font-size:var(--fs-sm)}
.ed-dirtybar span{color:var(--fg-2)}
/* 面包屑（IDEA 在工具条下面也有这一条）：一眼看清「我在哪个文件的哪一层」。
   点前面的段就把左边这棵树筛到那一层——找同级文件不用再一层层点开。 */
.ed-crumb{display:flex;align-items:center;gap:1px;flex-wrap:wrap;
  padding:6px var(--s4);border-bottom:1px solid var(--line);background:var(--surface)}
.ed-crumb .crumb{border:0;background:transparent;cursor:pointer;padding:3px 6px;
  border-radius:var(--r-xs);font-size:11.5px;color:var(--muted);font-family:var(--mono)}
.ed-crumb .crumb:hover{background:var(--sunken);color:var(--fg)}
.ed-crumb .crumb.last{color:var(--fg);font-weight:650}
.ed-crumb .sep{color:var(--faint);font-size:11px}

/* 当前行：一条横带。用 transform 推位置（不触发布局），滚动也跟着走。 */
.ed-hl{position:absolute;left:0;right:0;height:20px;background:var(--sunken);
  will-change:transform;pointer-events:none}
.ed-gutter{position:relative}
.ed-gl{position:absolute;right:0;width:2px;height:20px;background:var(--primary);
  pointer-events:none}
/* 缩进参考线：几层缩进画几条竖线。深嵌套的代码靠它对齐，不用数空格。 */
.ed-guides{position:absolute;inset:0;pointer-events:none;
  font-family:var(--mono);font-size:12.5px;line-height:20px}
.ed-guides i{position:absolute;top:0;bottom:0;width:1px;
  background:repeating-linear-gradient(180deg,var(--line) 0 3px,transparent 3px 6px);
  opacity:.85}
.ed-foot{display:flex;align-items:center;gap:var(--s2)}
.ed-foot #edLnCol{font-variant-numeric:tabular-nums}

/* ── 多文件标签：IDEA 的那一条。开着几个文件就摆几个，不用回树里找 ── */
.ed-tabs{display:flex;align-items:stretch;gap:1px;flex:none;overflow-x:auto;
  background:var(--sunken);border-bottom:1px solid var(--line);min-height:32px}
.ed-tabs:empty{display:none}
.etab{display:flex;align-items:center;gap:6px;flex:none;max-width:210px;
  border:0;background:var(--surface);cursor:pointer;padding:0 8px 0 11px;height:32px;
  font-size:var(--fs-sm);color:var(--muted);font-family:var(--mono);
  border-right:1px solid var(--line)}
.etab:hover{color:var(--fg)}
.etab.on{background:var(--bg);color:var(--fg);box-shadow:inset 0 2px 0 var(--primary)}
.etab .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.etab .x{flex:none;color:var(--faint);border-radius:4px;padding:0 3px;line-height:14px}
.etab .x:hover{background:var(--sunken);color:var(--danger-text)}

/* ── 编辑器内的查找栏：贴在右上角，不占正文空间 ── */
.ed-find{position:absolute;right:14px;top:8px;z-index:6;display:flex;align-items:center;gap:4px;
  background:var(--surface);border:1px solid var(--line-2);border-radius:var(--r-sm);
  box-shadow:var(--shadow-pop);padding:4px 6px}
.ed-find input{width:190px;border:1px solid var(--line);border-radius:var(--r-xs);
  padding:4px 8px;font-size:var(--fs-sm);font-family:var(--mono);background:var(--bg)}
.ed-find .fcnt{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;
  min-width:44px;text-align:right;font-family:var(--mono)}
/* 配对括号：两个方框，一眼看出「这一对」在哪 */
.ed-brk{position:absolute;width:9px;height:20px;pointer-events:none;
  box-shadow:inset 0 0 0 1px var(--primary);border-radius:2px;background:var(--primary-soft);
  opacity:.85}

/* ── 底部工具窗 ───────────────────────────────────────────
   学 IDEA：一处放「问题 / 终端 / 消息」，一行一条、列对齐、等宽数字。
   信息密度靠的是行高 22px + 头发丝分隔 + 表格化的列，不是靠缩小字号。 */
/* 底部这一栏是「工具窗」，不是「一整块面板」：默认只占一小条，
   需要看输出时自己往上拖。它不该抢编辑区的地方。 */
:root{ --dock-h:172px }
.dock{position:fixed;left:var(--side);right:0;bottom:var(--bar-h);height:var(--dock-h);
  z-index:45;display:flex;flex-direction:column;background:var(--surface);
  border:1px solid var(--line);border-bottom:0;border-radius:var(--r-lg) var(--r-lg) 0 0;
  box-shadow:0 -14px 34px -26px rgba(96,72,48,.55);
  animation:dockIn var(--t) var(--ease-soft)}
@keyframes dockIn{from{transform:translateY(12px);opacity:0}to{transform:none;opacity:1}}
body.dock-open main{padding-bottom:calc(var(--dock-h) + var(--s5))}
.dock-tabs{display:flex;align-items:center;gap:var(--s1);flex:none;height:36px;
  padding:0 var(--s2);border-bottom:1px solid var(--line)}
.dtab{display:flex;align-items:center;gap:6px;border:0;background:transparent;cursor:pointer;
  padding:4px 11px;border-radius:var(--r-full);font-size:var(--fs-sm);color:var(--muted);
  font-weight:600;transition:background var(--t-fast) var(--ease-soft),color var(--t-fast) var(--ease-soft)}
.dtab:hover{color:var(--fg);background:var(--sunken)}
.dtab.on{background:var(--primary-soft);color:var(--primary-text)}
.dtab .cnt{font-size:11px;font-family:var(--mono);font-variant-numeric:tabular-nums;
  color:var(--muted);background:var(--inset);border-radius:99px;padding:0 6px;line-height:15px;
  min-width:16px;text-align:center}
.dtab.hot .cnt{background:var(--danger-soft);color:var(--danger-text)}
.dtab .cnt[data-zero="1"]{display:none}
.dock-hint{font-size:11.5px;color:var(--faint);font-family:var(--mono);padding-right:var(--s2)}
.dock-tabs .iconbtn{height:34px;padding:0 10px;font-size:12px;color:var(--muted)}
.dock-tabs .iconbtn:hover{color:var(--fg);background:var(--surface)}
/* 有东西在流进来、但我不弹出来打扰你：只在状态栏那两个字上闪一下 */
.bit.pulse{color:var(--primary-text);animation:pulseDot 1.1s var(--ease-soft) infinite alternate}
@keyframes pulseDot{from{opacity:.55}to{opacity:1}}
.dock-body{flex:1;min-height:0;display:flex}
.dpane{display:none;flex:1;min-height:0;flex-direction:column}
.dpane.on{display:flex}
.dfilter{display:flex;align-items:center;gap:6px;flex:none;padding:6px var(--s4);
  border-bottom:1px solid var(--line);font-size:11.5px;color:var(--muted)}
.dchip{border:1px solid var(--line);background:var(--surface);cursor:pointer;
  border-radius:99px;padding:1px 9px;font-size:11.5px;color:var(--muted)}
.dchip:hover{border-color:var(--line-2);color:var(--fg)}
.dchip.on{background:var(--primary-soft);border-color:var(--primary-line);color:var(--primary-text);font-weight:650}
.dsplit{flex:1;min-height:0;display:grid;grid-template-columns:minmax(300px,1fr) minmax(0,1.15fr)}
.dlist{overflow:auto;min-height:0}
.dsplit>.dlist{border-right:1px solid var(--line)}
.drow{display:grid;grid-template-columns:16px minmax(0,1fr) auto auto;align-items:center;
  gap:8px;padding:0 12px;height:23px;cursor:pointer;font-size:var(--fs-sm);color:var(--fg-2);
  border-bottom:1px solid color-mix(in srgb,var(--line) 55%,transparent)}
.drow:hover{background:var(--sunken)}
.drow.on{background:var(--primary-soft);color:var(--primary-text)}
.drow .sev{font-size:11px;text-align:center;font-weight:700}
.drow.error .sev{color:var(--danger-text)}
.drow.warn .sev{color:var(--warn)}
.drow.info .sev{color:var(--faint)}
.drow .tt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.drow .src{color:var(--faint);font-family:var(--mono);font-size:11px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:230px}
.drow .tag{color:var(--faint);font-size:11px;font-family:var(--mono);font-variant-numeric:tabular-nums}
.dgroup{padding:5px 12px 3px;font-size:11px;color:var(--muted);background:var(--sunken);
  border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2;
  display:flex;align-items:baseline;gap:var(--s2)}
.dgroup b{color:var(--fg-2);font-weight:650}
.ddetail{overflow:auto;padding:var(--s3) var(--s4)}
.dempty{color:var(--muted);font-size:var(--fs-sm);line-height:1.8}
.ddetail h4{margin:0 0 4px;font-size:var(--fs);font-weight:650}
.ddetail .dsec{margin:0 0 var(--s3)}
.ddetail .dk{font-size:11px;color:var(--faint);margin-bottom:3px}
.ddetail ul{margin:0;padding-left:18px;font-size:var(--fs-sm);color:var(--fg-2);line-height:1.75}
.ddetail code{font-family:var(--mono);font-size:11.5px;background:var(--inset);
  padding:1px 5px;border-radius:var(--r-xs)}
.term{flex:1;margin:0;padding:10px 14px;overflow:auto;font-family:var(--mono);
  font-size:12px;line-height:18px;color:var(--fg-2);white-space:pre-wrap;word-break:break-all}
.term .e{color:var(--danger-text)}
.term .l{color:var(--muted)}
.term .s{color:var(--primary-text)}
.msg{display:grid;grid-template-columns:52px 18px minmax(0,1fr);gap:8px;align-items:baseline;
  padding:5px 12px;border-bottom:1px solid color-mix(in srgb,var(--line) 55%,transparent);
  font-size:var(--fs-sm)}
.msg:hover{background:var(--sunken)}
.msg .t{color:var(--faint);font-family:var(--mono);font-size:11px}
.msg .i{text-align:center;font-weight:700}
.msg.block .i{color:var(--danger-text)}
.msg.warn .i{color:var(--warn)}
.msg.info .i{color:var(--ok-text)}
.msg .txt b{display:block;color:var(--fg);font-weight:600}
.msg .txt div{color:var(--fg-2);line-height:1.7}
/* 抓手做成一个小胶囊：看得见、拖得动，不是一条隐形的热区 */
.dock-grip{position:absolute;left:50%;top:2px;width:56px;height:5px;margin-left:-28px;
  cursor:ns-resize;border-radius:99px;background:var(--line-2);
  transition:background var(--t-fast) var(--ease-soft)}
.dock-grip:hover{background:var(--primary)}
.dock-tabs{padding-left:calc(var(--s2) + 4px)}

/* 环境光分两层：外层吃"鼠标视差"，内层自己慢慢飘（互不打架） */
.ambient{will-change:transform}
.ambient-i{position:absolute;inset:0;background:inherit;
  animation:drift 38s var(--ease-soft) infinite alternate}

/* 物品格高亮：悬停时内侧来一条高光，外加一道很慢的斜扫（附魔微光那味儿）*/
.pcard,.item,.runcard,.diag{position:relative}
.pcard::after,.item::after,.runcard::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(96deg,transparent 42%,color-mix(in srgb,var(--surface) 70%,transparent) 50%,transparent 58%);
  transform:translateX(-135%);opacity:0}
.pcard:hover::after,.item:hover::after{opacity:.75;animation:glint 1.7s var(--ease-soft) .06s 1}
@keyframes glint{to{transform:translateX(135%)}}
.pcard:hover,.item:hover,.diag:hover{box-shadow:inset 0 1px 0 color-mix(in srgb,var(--surface) 80%,transparent),var(--shadow-2)}

/* 按下微沉：指针按下去的那一下要有回应 */
.pcard:active,.item:active,.diag:active{transform:translateY(0) scale(.996)}

/* 拾取粒子：成功时从状态点散出几颗小光点 */
.spark{position:fixed;width:5px;height:5px;border-radius:50%;pointer-events:none;z-index:150;
  background:var(--primary);opacity:.9;
  animation:spark .62s var(--ease-soft) forwards}
@keyframes spark{
  from{transform:translate(-50%,-50%) rotate(var(--a)) translateX(2px) scale(1);opacity:.9}
  to{transform:translate(-50%,-50%) rotate(var(--a)) translateX(var(--d)) scale(.35);opacity:0}
}

/* tooltip 跟随光标时不要有跳变 */
.tip{transition:opacity var(--t-fast) var(--ease),transform var(--t-fast) var(--ease),left 90ms linear,top 90ms linear}

/* ══════════════════════════════════════════════════════════════
   设计支线 · 圆融 v2 —— 照 MC 顶级整合包 UI 的做法重排视觉

   MC 那批做得最好的界面（MUI / EMI / Reese's Sodium Options）共同的规律：
     1. 三层面：暗一点的底 → 暖一点的面 → 再亮一点的前景。分层靠明度，不靠描边。
     2. 主色只用在**小面积**上（选中、开关、关键按钮）。大面积用中性的暖砂。
     3. 圆角只有三档，且同一层级必须一样大。
     4. 分隔几乎不用线；要让两组东西分开，就给其中一组换个底色。
     5. 动效快、短、带一点点回弹；悬停是"浮起一点点"，不是换颜色。
   目标：像一个东西，而不是像几个控件拼起来的东西。
   ══════════════════════════════════════════════════════════════ */
:root{
  /* 暖砂三层面（明度差控制在 3–5%，肉眼看着是"层次"而不是"色块"） */
  --bg:#f6f2ec;          /* 底板：最暗的一层 */
  --surface:#fdfbf7;     /* 工作面：编辑器、卡片 */
  --inset:#f1ece4;       /* 嵌进面里的块 */
  --sunken:#eae4da;      /* 更沉的一档：工具窗、表头 */
  --line:#ebe5db; --line-2:#ded6c9;

  /* 主色：把饱和度收回来。大面积铺满的琥珀会显得吵，
     只在"当前选中""主要动作"这种小面积上用完整的它。 */
  --primary:#e8b04b;     /* 实体填充（按钮） */
  --primary-hover:#f0bd63;
  --primary-soft:#fbf0d8;/* 选中态底 */
  --primary-line:#e7cf9c;
  --primary-text:#96631a;

  /* 状态色也一起收一档，避免和暖底打架 */
  --danger:#d95436; --danger-text:#b9431f; --danger-soft:#fbe7e1;
  --ok:#4f9b5c; --ok-text:#357440; --ok-soft:#e8f3ea;
  --warn:#a8761c; --warn-soft:#fbf0d8;
  --info:#55788f; --info-soft:#e9eff4;

  /* 底栏：不用近黑。暖炭色才和上面这一家是一家人。 */
  --bar-bg:#3b332b; --bar-fg:#e4dcd0; --bar-dim:#a2958a;
}

/* ══════════════════════════════════════════════════════════════
   设计支线 · 圆融（design/roundness）

   IDEA 看着「圆融」，不是因为它圆角大，是因为三件事做到了统一：
     1. 分隔靠「面的明度差」，不靠线。线只是最后 5% 的提示。
     2. 选中是**一条内缩的圆角色带**，不是一堵贴边的墙 + 左侧竖条。
     3. 控件高度只有两档（24 / 28），半径只有三档（4 / 6 / 8）。
   下面这一段是覆盖层：只调这三件事，不动任何功能选择器。
   ══════════════════════════════════════════════════════════════ */
:root{
  --r-xs:4px; --r-sm:6px; --r:8px; --r-lg:12px; --r-xl:16px;
  /* 线的对比度降一档：能看见，但不会在屏幕上划出格子 */
  --line:#eceae7; --line-2:#dcdad5;
  --row-h:24px;        /* 列表行只有这一档高度 */
  --ctl-h:28px;        /* 控件只有这一档高度（小号 24） */
}

/* hidden 必须真的藏住。
   踩过的坑：`.ed-find{display:flex}` 会盖掉浏览器默认的 `[hidden]{display:none}`，
   于是「查找」栏在没被叫出来的时候也挂在屏幕右上角。这条兜底，谁都别再踩。 */
[hidden]{display:none !important}
[data-theme="dark"]{
  --line:#3a3733; --line-2:#4b4740;
}

/* ── 选中：内缩的圆角色带 ───────────────────────────────── */
.ed-node,.dep-row,.rail-projs .rp,.drow,.nb-item,.item{
  margin:0 6px;border-radius:var(--r-sm);
  border-bottom:0;                     /* 行与行之间不画线，靠悬停的色带区分 */
}
.ed-node{height:var(--row-h);padding-left:calc(6px + var(--d,0) * 15px);padding-right:8px}
.ed-node.on{background:var(--primary-soft);box-shadow:none}   /* 取消左侧竖条 */
.ed-node:hover{background:color-mix(in srgb,var(--sunken) 70%,transparent)}
.dep-row{height:var(--row-h);padding:0 8px}
.dep-row:hover,.rail-projs .rp:hover{background:color-mix(in srgb,var(--sunken) 70%,transparent)}
.drow{height:var(--row-h);padding:0 8px}
.drow.on{background:var(--primary-soft);box-shadow:none}

/* ── 控件：统一高度与半径，去掉"会飘起来"的悬停 ─────────── */
.btn{border-radius:var(--r-sm);min-height:var(--ctl-h);box-shadow:none}
.btn.sm{min-height:24px}
.btn:hover,.banner:hover,.diag:hover{transform:none}          /* 颜色给反馈，位移不给 */
.iconbtn,button.dchip,.etab,.dtab{border-radius:var(--r-sm)}
.dtab{border-radius:999px}                                     /* 页签例外：胶囊才像"页签" */
.ed-tabs .etab{height:30px;border-right:0;border-radius:var(--r-sm) var(--r-sm) 0 0}
.ed-tabs .etab.on{box-shadow:none;background:var(--bg);
  border-top:2px solid var(--primary)}                          /* 顶缘一条细线，替代整块描边 */

/* ── 分隔线：只留在"结构性"的位置 ───────────────────────── */
.ed-bar,.ed-foot,.dock-tabs,.rail-sub,.rail-head,.dfilter{border-color:var(--line)}
.ed-side{border-right-color:var(--line)}
.dock{border-color:var(--line);border-radius:var(--r-lg) var(--r-lg) 0 0}
.banner,.panel,.projDetail,.launch,.ed-menu,.tip{border-color:var(--line)}

/* ── 头像块/图标这些小东西，半径跟控件对齐 ─────────────── */
.ed-node .ico{border-radius:2px}
.ed-node .ico.d{border-radius:2px}

/* ── 工作区：让三层面读得出来 ───────────────────────────── */
body{background:var(--bg)}
.ed-main{background:var(--surface)}
.ed-side{background:var(--sunken)}
.ed-tools{background:var(--sunken);border-bottom-color:var(--line)}
.ed-tools input{background:var(--surface)}
/* 激活的页签要和下面的画布连成一片——中间不断开，才不会看着像两个东西 */
.ed-tabs{background:var(--sunken);border-bottom-color:var(--line);gap:2px;padding:4px 6px 0}
.ed-tabs .etab{background:transparent;color:var(--muted);height:28px;
  border:0;border-bottom:0;padding:0 10px;border-radius:var(--r-sm) var(--r-sm) 0 0}
.ed-tabs .etab:hover{background:color-mix(in srgb,var(--surface) 55%,transparent);color:var(--fg)}
.ed-tabs .etab.on{background:var(--surface);color:var(--fg);
  border-top:2px solid var(--primary);font-weight:600}
.ed-bar{background:var(--surface);border-bottom-color:var(--line)}
.ed-crumb{background:var(--surface);border-bottom-color:var(--line);padding:4px var(--s4) 6px}

/* ── 工具窗与列表：分组靠底色，不靠线 ───────────────────── */
.rail{background:var(--surface);border-left-color:var(--line)}
.rail-head{border-bottom:0}
.rail-projs{border-bottom:0;padding-bottom:var(--s1)}
.rail-projs .rp{color:var(--fg-2)}
.rail-projs .rp.on{background:var(--primary-soft);color:var(--primary-text);font-weight:650;
  box-shadow:none}
.rail-sub{background:var(--sunken);border-top:0}
.dgroup{background:var(--sunken);border-bottom:0}
.dep-grp{background:transparent;border-bottom:0;border-radius:var(--r-sm);margin:0 6px}
.dep-grp:hover{background:color-mix(in srgb,var(--sunken) 70%,transparent)}

/* ── 悬浮的东西：只给它们描边和影子 ─────────────────────── */
.launch .lcard,.ed-menu,.tip,.projDetail,.panel,.fb{
  border:1px solid var(--line);box-shadow:var(--shadow-pop);border-radius:var(--r-lg)}

/* ── 底栏：矮一点、暖一点、把噪声压掉 ───────────────────── */
.bar{background:var(--bar-bg);color:var(--bar-fg);border-top:0;height:26px;
  gap:var(--s5);font-size:11.5px}
.bar .bit{color:var(--bar-dim)}
.bar .bit b{color:var(--bar-fg);font-weight:600}
.bar .bit.act{border-radius:var(--r-full);padding:1px 9px;background:rgba(255,255,255,.07)}
.bar .bit.act:hover{background:rgba(255,255,255,.13);color:#fff}
.bar .bit.pulse{color:var(--primary)}

/* ── 悬停：浮起来一点点，别换颜色（MC 的手感就是这样）──── */
.ed-node,.dep-row,.drow,.rail-projs .rp,.nb-item{
  transition:background var(--t-fast) var(--ease-soft),transform var(--t-fast) var(--ease-soft)}
.ed-node:active,.dep-row:active,.rail-projs .rp:active{transform:scale(.995)}

/* ── 文件类型徽标：底色 + 字母，比小方块有信息量 ─────────── */
.ed-node .ico{width:19px;height:15px;flex:none;border-radius:3px;
  font-family:var(--mono);font-size:8.5px;font-weight:700;line-height:15px;text-align:center;
  letter-spacing:.2px;color:#fff;background:var(--faint)}
.ed-node .ico.d{width:15px;height:12px;background:transparent;border-radius:0}
.ed-node .ico.rs{background:#c8823f}
.ed-node .ico.py{background:#4a7ba6}
.ed-node .ico.js{background:#c9a227}
.ed-node .ico.jv{background:#bd6a49}
.ed-node .ico.cc{background:#6e8fb4}
.ed-node .ico.cf{background:#9a8f7a}
.ed-node .ico.md{background:#7f9e6b}
.ed-node .ico.fx{background:color-mix(in srgb,var(--faint) 60%,transparent)}
.ed-node .ico.ht{background:#bf6a58}
.ed-node .ico.cs{background:#4a7ba6}
.ed-node .ico.im{background:#8a7bb0}
.ed-node.dir .ico.d{background:var(--primary-text);width:13px;height:10px;border-radius:2px}

/* ── 弹出菜单：动作名 + 一行说明，密度高但不挤 ─────────── */
.ed-menu-sm{min-width:230px;padding:6px}
.ed-menu-sm button{display:block;width:100%;text-align:left;border:0;background:transparent;
  padding:7px 10px;border-radius:var(--r-sm);cursor:pointer;font-family:var(--font)}
.ed-menu-sm button:hover{background:var(--inset)}
.ed-menu-sm button:disabled{opacity:.45;cursor:default}
.ed-menu-sm button small{display:block;color:var(--muted);font-size:11px;margin-top:2px}

/* ── 弹簧手感：MC 那批界面的"回弹"来源就是这个曲线 ─────── */
:root{ --ease-spring:cubic-bezier(.34,1.4,.64,1) }
.launch .lcard{animation:popIn 220ms var(--ease-spring)}
@keyframes popIn{from{transform:scale(.97) translateY(6px);opacity:0}
  to{transform:scale(1) translateY(0);opacity:1}}
.ed-menu{animation:popIn 140ms var(--ease-spring);transform-origin:top left}

/* ══════════════════════════════════════════════════════════════
   全页统一：概览 / 运行 / 记录 / 清理 / 机器清单

   编辑器那一页已经按「暖砂三层面 + 圆角三档 + 分隔靠底色」立起来了。
   这一段把其余几页拉到同一套规矩里——它们之前各写各的，所以看着像
   五个不同的人做的五个页面。

   三档圆角在这里的用法固定下来：
     6px = 行、按钮、输入框（可以点的东西）
     10px = 页面上的一张小卡（一组的边界）
     14px = 浮在最上面的东西（弹层、通知、启动屏）
   ══════════════════════════════════════════════════════════════ */
:root{ --r-card:10px; --r-float:14px }

/* ── 页面骨架 ───────────────────────────────────────────── */
.view{max-width:1200px}
.toolbar{background:transparent;border:0;padding:var(--s5) 0 var(--s3);
  display:flex;align-items:flex-end;gap:var(--s4);flex-wrap:wrap}
.toolbar .big{font-size:var(--fs-xl);font-weight:700;letter-spacing:-.2px;line-height:1.3}
.secTitle{margin:var(--s5) 0 var(--s2);font-size:var(--fs-sm);font-weight:650;
  color:var(--muted);letter-spacing:.2px;display:flex;align-items:baseline;gap:var(--s2)}
.secTitle::after{content:"";flex:1;height:1px;background:var(--line)}   /* 标题拉一条发丝线到底 */

/* ── 一张卡：面 + 圆角 + 暖影 ───────────────────────────── */
.panel,.status,.cardNotes,.findings .finding,.fact,.item,.zone,.notebook,
.projDetail,.pstep,.dep-manifest,.setGroup,.deep,.audit,.switcher .menu{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);
  box-shadow:0 1px 2px rgba(120,92,60,.04)}
.panel{padding:var(--s4)}
.panel h3,.panel h2{margin:0 0 var(--s3);font-size:var(--fs-md);font-weight:700}

/* 列表行：等高于 24px，行的分隔只在"表"里出现 */
.fact,.setrow,.item{padding:7px 10px;border-radius:var(--r-sm);
  transition:background var(--t-fast) var(--ease-soft)}
.fact:hover,.setrow:hover,.item:hover{background:var(--inset)}

/* ── 状态条：整页的第一句话 ─────────────────────────────── */
.status{padding:var(--s4) var(--s5);display:flex;gap:var(--s4);align-items:flex-start}
.status .face{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;
  font-size:17px;font-weight:700;flex:none}
.status.ok .face{background:var(--ok-soft);color:var(--ok-text)}
.status.warn .face{background:var(--warn-soft);color:var(--warn)}
.status h2{margin:0 0 4px;font-size:var(--fs-lg);font-weight:700}
.status p{margin:0;color:var(--fg-2);line-height:1.75}

/* ── 诊断条目：左边只用一条 3px 语义色，其余全平 ─────────── */
.finding{padding:var(--s3) var(--s4) var(--s3) calc(var(--s4) - 3px);
  border-left:3px solid var(--line);border-radius:0 var(--r-card) var(--r-card) 0;
  margin-bottom:var(--s2)}
.finding.error{border-left-color:var(--danger)}
.finding.warn{border-left-color:var(--warn)}
.finding.info{border-left-color:var(--line-2)}
.finding .ftitle{font-size:var(--fs);font-weight:650;display:flex;gap:var(--s2);align-items:baseline}
.finding .next{color:var(--fg-2);margin-top:4px;font-size:var(--fs-sm);line-height:1.7}
.finding .boundary{color:var(--muted);font-size:11.5px;margin-top:3px}
.finding details{margin-top:6px}
.finding summary{cursor:pointer;color:var(--muted);font-size:11.5px}
.finding code{background:var(--inset);padding:1px 5px;border-radius:var(--r-xs);font-size:11.5px}
.layer{display:flex;align-items:baseline;gap:var(--s2);margin:var(--s4) 0 var(--s2);
  font-size:var(--fs-sm);color:var(--muted)}
.layer b{color:var(--fg-2);font-weight:650}

/* ── 运行页：一条龙的四步 ───────────────────────────────── */
.pipeline{display:flex;align-items:stretch;gap:var(--s2);flex-wrap:wrap;
  background:transparent;border:0;padding:var(--s3) 0}
.pstep{flex:1 1 190px;min-width:0;padding:var(--s3);text-align:left;cursor:pointer;
  display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;
  gap:4px var(--s2);align-items:center;
  transition:background var(--t-fast) var(--ease-soft),border-color var(--t-fast) var(--ease-soft)}
.pstep:hover{background:var(--inset);border-color:var(--line-2)}
.pstep.primary{background:var(--primary-soft);border-color:var(--primary-line)}
.pstep b{font-size:var(--fs);font-weight:650}
.pstep .pcmd{grid-column:2;color:var(--muted);font-family:var(--mono);font-size:11px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pstep .pdot{width:8px;height:8px;border-radius:50%;background:var(--line-2)}
.pstep[data-state="busy"] .pdot{background:var(--primary);animation:pulseDot 1s infinite alternate}
.pstep[data-state="ok"] .pdot{background:var(--ok)}
.pstep[data-state="fail"] .pdot{background:var(--danger)}
.parrow{align-self:center;color:var(--faint)}

/* ── 清理页：三个区按"能不能删"用底色分开，不用色块标题 ─── */
.zone{padding:var(--s4);margin-bottom:var(--s3)}
.zone h3{margin:0 0 var(--s2);font-size:var(--fs);font-weight:700;display:flex;
  align-items:baseline;gap:var(--s2)}
.zone .zhint{color:var(--muted);font-size:var(--fs-sm);line-height:1.75;margin-bottom:var(--s3)}
.zone.noTouch{background:color-mix(in srgb,var(--danger-soft) 45%,var(--surface));
  border-color:color-mix(in srgb,var(--danger) 18%,var(--line))}
.item .path{font-family:var(--mono);font-size:11px;color:var(--muted);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item .why{color:var(--fg-2);font-size:11.5px;margin-top:2px;line-height:1.65}
.item .label{font-weight:650}

/* ── 记录页：左列表右编辑，中间一条发丝线 ───────────────── */
.notebook{overflow:hidden;border-radius:var(--r-card)}
.nb-list{border-right:1px solid var(--line);background:var(--surface)}
.nb-tools{padding:var(--s2) var(--s3);border-bottom:1px solid var(--line);gap:var(--s2)}
.nb-tools input{background:var(--bg)}
.nb-items{background:var(--surface)}
.noteTop-bar{padding:var(--s3) 0 var(--s2)}
.nb-editor{background:var(--surface)}
.nb-foot{border-top:1px solid var(--line);padding:var(--s2) var(--s3);background:var(--inset)}
.nb-empty{color:var(--muted);font-size:var(--fs-sm);padding:var(--s4);line-height:1.8}

/* ── 概览：项目横幅与附属卡 ─────────────────────────────── */
.banner{border-radius:var(--r-card);padding:var(--s3) var(--s4);gap:var(--s3)}
.projDetail{border-radius:var(--r-card);padding:var(--s4)}
.scanbar{gap:var(--s2);padding:var(--s2) 0}
.pager{gap:var(--s2);padding:var(--s3) 0}

/* ── 机器清单：成对出现的"名 → 值"，值一律等宽 ───────────── */
.fact .k{color:var(--muted);font-size:11.5px}
.fact .v{font-family:var(--mono);font-variant-numeric:tabular-nums}
.setGroup{padding:var(--s3) var(--s4);margin-bottom:var(--s3)}
.setrow{display:flex;align-items:center;gap:var(--s3);min-height:32px}

/* ── 设置 / 快捷开关这类小控件 ─────────────────────────── */
.opt,.sw{border-radius:var(--r-full)}
.sf-line{border-radius:var(--r-sm);background:var(--inset);padding:6px 10px;
  font-family:var(--mono);font-size:11.5px}

/* ── 悬浮提示与通知：都是浮层，用最大那档圆角 ───────────── */
.toast,.feed .fb,.band{background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r-float);box-shadow:var(--shadow-pop)}
.band{border-radius:var(--r-float) var(--r-float) 0 0}

/* ── 悬停一律"换底不换位"：整页只有点击才有位移 ─────────── */
.panel:hover,.zone:hover,.pstep:hover,.item:hover{transform:none}

/* ══════════════════════════════════════════════════════════════
   MC 顶级整合包 UI 的底子：Material / Android 那套语义

   查了 Modern UI（MUI，2300 万下载）自己的说明——它写得很直白：
   「改进并优化了一套 Google Android 用的特性」。也就是说，
   MC 里那批做得最"圆融"的界面，圆融的来源不是 MC，是 Android。
   三条可以直接搬过来的：
     1. 状态层（state layer）：悬停/按下不是"换个背景色"，而是在
        原有底色上叠一层**半透明的强调色**。所以它永远和底色是亲戚，
        不会出现"悬停一下这块忽然变成另一种灰"的违和。
     2. 色调动面（tonal surface）：面不是纯中性灰，往强调色偏一点点。
     3. 同心圆角：外面的圆角 = 里面的圆角 + 内边距，嵌套才不"咬"。
   ══════════════════════════════════════════════════════════════ */
:root{
  --state-hover:10%;    /* 悬停叠 10% 强调色 */
  --state-press:16%;    /* 按下叠 16% */
  --ease-emph:cubic-bezier(.2,0,0,1);   /* 大面用这条；小控件用 --ease-soft */
  /* 色调动面：中性砂里掺一点琥珀，整屏才是一家人 */
  --surface:color-mix(in srgb, #fdfbf7 96%, #e8b04b);
  --bg:color-mix(in srgb, #f6f2ec 96%, #e8b04b);
  --sunken:color-mix(in srgb, #eae4da 95%, #c98a3c);
}

/* 状态层：叠一层，不改底 */
.btn:hover,.ed-node:hover,.dep-row:hover,.drow:hover,.rail-projs .rp:hover,
.item:hover,.setrow:hover,.fact:hover,.pstep:hover,.dchip:hover,.iconbtn:hover{
  background-image:linear-gradient(
    color-mix(in srgb, var(--primary) var(--state-hover), transparent),
    color-mix(in srgb, var(--primary) var(--state-hover), transparent));
}
.btn:active,.ed-node:active,.dep-row:active,.rail-projs .rp:active,.dchip:active{
  background-image:linear-gradient(
    color-mix(in srgb, var(--primary) var(--state-press), transparent),
    color-mix(in srgb, var(--primary) var(--state-press), transparent));
}
/* 主按钮的悬停要在它的实底上叠，不然会被"浮白" */
.btn:not(.ghost):hover{background-image:linear-gradient(rgba(0,0,0,.06),rgba(0,0,0,.06))}

/* 同心圆角：外层 12 + 内边距 6 = 内层 6。写在这儿当规矩，改圆角时照着抄。 */
.panel,.zone,.notebook,.setGroup,.projDetail,.pstep{--r-inner:calc(var(--r-card) - 6px)}
.panel .item,.zone .item,.notebook .nb-items,.setGroup .setrow{border-radius:var(--r-inner)}

/* 大面的过渡用强调曲线（200ms）：面积越大，动得越慢才稳 */
.view,.panel,.zone,.status,.banner{transition:background-color 200ms var(--ease-emph),
  border-color 200ms var(--ease-emph)}

/* ── 界面管理：照 Reese's Sodium Options 那张页的骨架 ───────
   从展示图上读到的四条结构（不是配色）：
     1. 分组小标题是**通栏的一行小灰字**，它下面的项不要给它加底色块；
     2. 值一律右对齐成一列，眼睛竖着扫就看得出来"哪些不一样"；
     3. 行与行之间不画线，靠悬停高亮（它们整页没有一条分隔线）；
     4. 动作按钮在**右下角**，不在右上角。
   我们之前的做法反着来的：分组头带底色、值左对齐、动作挤在右上。
   ─────────────────────────────────────────────────────────── */
.dep-grp,.dgroup,.rail-sec,.layer{background:transparent;border:0;box-shadow:none;
  margin:var(--s4) 0 var(--s1);padding:0 10px;height:auto;min-height:18px;
  font-size:11.5px;font-weight:600;color:var(--muted);letter-spacing:.2px;
  display:flex;align-items:baseline;gap:var(--s2);cursor:default;border-radius:0}
.dep-grp:hover,.dgroup:hover{background:transparent}
.dep-grp .chev{color:var(--faint)}
.dep-grp .cnt,.dgroup .cnt{margin-left:auto;font-family:var(--mono);font-size:11px;
  color:var(--faint);font-variant-numeric:tabular-nums}
.dep-grp{cursor:pointer}          /* 只有依赖分组能折叠，其余是纯标题 */
.dep-grp:hover .chev{color:var(--fg-2)}

/* 值列右对齐：这是"能不能一眼比较"的关键 */
.fact{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s4);align-items:baseline}
.fact .k{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fact .v{text-align:right}
.setrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s4);align-items:center}
.dep-row .vd{text-align:right}
.item .row-line{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s3);align-items:baseline}

/* 动作在右下角：页面级的操作区统一这么摆 */
.wrow,.row2{display:flex;justify-content:flex-end;gap:var(--s2);margin-top:var(--s4)}
.toolbar{justify-content:flex-start}

/* ── 「只在偏离默认时才出现」的标记与还原（照 RSO 的做法）──
   平常设置页是干净的；一旦你改过某一项，那一行左边亮一个小点，
   悬停行尾出现「还原」。不用记住自己改了什么，也永远退得回去。 */
.opt,.setrow{position:relative;align-items:center}
.opt{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s4);
  padding:8px 10px;border-radius:var(--r-sm)}
.opt .lbl b{font-weight:600}
.opt .lbl span{display:block;color:var(--muted);font-size:11.5px;line-height:1.7;margin-top:2px}
.changed{background:var(--primary-soft)}
.changed::before{content:"";position:absolute;left:-4px;top:50%;width:5px;height:5px;
  margin-top:-2.5px;border-radius:50%;background:var(--primary)}
.revert{position:absolute;right:8px;top:50%;transform:translateY(-50%);
  border:1px solid var(--line-2);background:var(--surface);color:var(--fg-2);
  font-size:11px;padding:2px 8px;border-radius:var(--r-full);cursor:pointer;
  opacity:0;transition:opacity var(--t-fast) var(--ease-soft)}
.opt:hover .revert,.setrow:hover .revert,.revert:focus-visible{opacity:1}
.revert:hover{background:var(--inset);color:var(--fg)}

/* ── 空状态那一页：别让内容飘在半空 ─────────────────────── */
/* 之前底下一大块死白，两个按钮浮在中间——因为没有给这一页定垂直节奏。
   现在整页按"上留白 → 内容 → 下留白"三等分，内容往上靠一点。 */
.welcome{min-height:calc(100vh - var(--top-h) - var(--bar-h) - 40px);
  display:flex;flex-direction:column;justify-content:flex-start;
  padding:min(9vh, 84px) 0 var(--s6);text-align:center}
.welcome .projList{margin-top:var(--s4)}
.welcome .wrow{margin-top:var(--s5)}
.welcome .hero-art{width:96px;height:96px;margin:0 auto var(--s3)}

/* 次要按钮要看得出来"是个按钮"：描边 + 透明底。
   之前它和白底输入框长得一模一样，放在页面上分不清哪个能点。 */
.btn.ghost{background:transparent;border:1px solid var(--line-2);color:var(--fg-2)}
.btn.ghost:hover{background:var(--inset);border-color:var(--faint);color:var(--fg)}
.btn.big{min-height:40px;padding:0 var(--s5);font-size:var(--fs-md)}
.btn.big.primary{background:var(--primary);color:var(--primary-fg)}
.ed-bar .btn{min-height:24px}
.ed-bar .btn + .btn{margin-left:2px}
.ed-bar .sep{width:1px;height:16px;background:var(--line);margin:0 4px}
/* 一个文件只需要写一次路径。
   上面那行工具条显示路径、下面又有一条面包屑，等于同一句话说两遍——
   留面包屑（它能点、能分层看），把工具条那行让给动作按钮。 */
.ed-bar #edPath{display:none}
.ed-bar{min-height:34px}
/* 工具窗别是一块死灰：让它的底比"面"只暗一档，空着的时候也不刺眼 */
.ed-side{background:color-mix(in srgb,var(--surface) 42%,var(--sunken))}

/* ── 传递依赖：行尾一个可展开的计数（EMI 的 recipe tree 用得上）──
   「这东西一共拉进来多少别的包」——不点开不占地方，点开才铺树。 */
.dep-row{grid-template-columns:13px minmax(0,1fr) auto auto}
.dep-row .tree-n{flex:none;font-family:var(--mono);font-size:10.5px;color:var(--primary-text);
  background:var(--primary-soft);border-radius:var(--r-full);padding:0 6px;line-height:15px;
  cursor:pointer;font-variant-numeric:tabular-nums}
.dep-row .tree-n:hover{background:var(--primary-line)}
.dep-row.sub{color:var(--fg-2);padding-left:calc(10px + var(--d,0) * 14px)}
.dep-row.sub .nm{font-size:11.5px;color:var(--fg-2)}
.dep-row.sub .vd{color:var(--faint);font-size:10.5px}

/* ══════════════════════════════════════════════════════════════
   键盘可达（a11y）——RSO 的功能表里专门有一条 "Improved keyboard navigation"。
   这不是"顺手做做"：一个要人天天用的工具，摸不到键盘就等于半残。
   规矩：焦点必须看得见（2px 暖色环），且只在键盘操作时出现
   （鼠标点击不弹环，否则满屏都是圈）。
   ══════════════════════════════════════════════════════════════ */
:focus{outline:none}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px;border-radius:var(--r-sm)}
.ed-node:focus-visible,.dep-row:focus-visible,.drow:focus-visible,.banner:focus-visible{
  outline-offset:-2px}                 /* 列表行贴边，环画在里面才不会溢出 */
.tablist button:focus-visible,.dtab:focus-visible,.etab:focus-visible{outline-offset:0}
/* 键盘用户的跳转锚点：平时不占地方，Tab 一下就出来 */
.skip{position:absolute;left:-9999px;top:var(--s2);z-index:200}
.skip:focus{position:fixed;left:var(--s4);top:var(--s2);background:var(--surface);
  border:1px solid var(--line-2);border-radius:var(--r-sm);padding:6px 12px;
  box-shadow:var(--shadow-pop);outline:2px solid var(--primary)}
/* 列表可聚焦：用 tabindex="0" 的行也能被 Tab 摸到，方向键在列表里走 */
[tabindex="0"]{outline-offset:2px}

/* ── 新建项目：独立弹窗卡片（照 IDEA 的 New Project）─────────
   之前它是页面下方的一块面板：得先滚下去找，而且和页面上别的东西
   混在一起，说不清"现在这一步是在干什么"。改成弹窗之后，
   它有自己的边界、自己的动作区，Esc / 点背景 / 右上 ✕ 都能关。 */
.modal{position:fixed;inset:0;z-index:120;display:grid;place-items:center;
  background:color-mix(in srgb,var(--bg) 55%,rgba(60,48,36,.45));
  backdrop-filter:blur(3px);animation:fadeIn var(--t) var(--ease-soft)}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-card{width:min(620px, calc(100vw - 48px));max-height:min(78vh, 720px);overflow:auto;
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r-float);
  box-shadow:0 30px 70px -30px rgba(70,52,36,.45);
  animation:popIn 220ms var(--ease-spring);transform-origin:center}
.modal-head{display:flex;align-items:center;gap:var(--s3);padding:var(--s4) var(--s5) var(--s2);
  border-bottom:1px solid var(--line)}
.modal-head h3{margin:0;font-size:var(--fs-lg);font-weight:700}
.modal-card .row{margin-top:var(--s3)}
.modal-card .row:first-of-type{padding-top:var(--s4)}
.modal-card .hint{margin:var(--s3) 0 0;padding:0 var(--s5)}
.modal-card .wrow{padding:0 var(--s5) var(--s5)}
/* 「将创建什么」：三行等活动区，值用等宽——和依赖栏同一套读法 */
.newpreview{margin:var(--s4) var(--s5) 0;padding:var(--s3) var(--s4);
  background:var(--inset);border-radius:var(--r-card)}
.np-row{display:grid;grid-template-columns:76px minmax(0,1fr);gap:var(--s3);align-items:baseline;
  min-height:22px;font-size:var(--fs-sm)}
.np-k{color:var(--muted);font-size:11.5px}
.np-v{font-family:var(--mono);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.np-note{margin-top:6px;color:var(--muted);font-size:11.5px;line-height:1.7}

/* 状态栏右端的编码标记：只在一个文件不是 UTF-8 时才用警示色，
   平时是普通弱文字——不制造噪声，但该看见的时候看得见。 */
#edEnc{font-family:var(--mono);font-size:11px;color:var(--muted);
  font-variant-numeric:tabular-nums;margin-right:var(--s3)}

/* ══ 运行时阶段流 ══════════════════════════════════════════
   设计目标（用户原话）：不是"一块很多字、看不清、闪完就没"的卡片，
   而是"多个信息窗口流式涌出，但不嘈杂，信息密度高"。
   做法：
     · 每一步一个**小面板**，按顺序涌出（错开 40ms，看着像流出来）；
     · 面板上只放结论行（名字/命令/状态/用时）+ **最多三条关键行**；
     · 原始输出折在面板内部——想看细节就展开，不想看它不占地方；
     · 跑完**不消失**：过程留在那儿，回头能对着看。
   ────────────────────────────────────────────────────────── */
.stream{margin:var(--s3) 0 var(--s4)}
.stream-head{display:flex;align-items:baseline;gap:var(--s3);padding:0 var(--s1) var(--s2)}
.stream-head b{font-size:var(--fs-md);font-weight:700}
.stream-head .hint{font-size:11.5px;color:var(--muted)}
.stage-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);
  padding:var(--s3) var(--s4);margin-bottom:var(--s2);
  animation:streamIn 200ms var(--ease-spring) both;
  animation-delay:calc(var(--i, 0) * 40ms)}
@keyframes streamIn{from{opacity:0;transform:translateY(8px) scale(.995)}to{opacity:1;transform:none}}
.stage-card.now{border-color:var(--primary-line);background:color-mix(in srgb,var(--primary-soft) 40%,var(--surface))}
.stage-card.ok{border-left:3px solid var(--ok)}
.stage-card.bad{border-left:3px solid var(--danger);
  background:color-mix(in srgb,var(--danger-soft) 40%,var(--surface))}
.sc-head{display:flex;align-items:baseline;gap:var(--s3);min-height:22px}
.sc-dot{width:8px;height:8px;border-radius:50%;background:var(--line-2);flex:none;align-self:center}
.stage-card.now .sc-dot{background:var(--primary);animation:pulseDot 1s var(--ease-soft) infinite alternate}
.stage-card.ok .sc-dot{background:var(--ok)}
.stage-card.bad .sc-dot{background:var(--danger)}
.sc-name{font-weight:650;font-size:var(--fs)}
.sc-cmd{color:var(--muted);font-family:var(--mono);font-size:11px;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap;max-width:46%}
.sc-ms{color:var(--faint);font-family:var(--mono);font-size:11px;font-variant-numeric:tabular-nums}
.sc-state{font-size:11.5px;color:var(--muted)}
.stage-card.ok .sc-state{color:var(--ok-text)}
.stage-card.bad .sc-state{color:var(--danger-text);font-weight:650}
/* 关键行：最多三条，等宽，贴着左边排成一行行——密集但不吵 */
.sc-keys{margin-top:6px}
.sc-key{font-family:var(--mono);font-size:11.5px;line-height:1.7;color:var(--fg-2);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sc-key.err{color:var(--danger-text)}
.sc-more{margin-top:6px}
.sc-more summary{cursor:pointer;color:var(--muted);font-size:11.5px}
.sc-more summary:hover{color:var(--fg-2)}
.sc-raw{margin:6px 0 0;max-height:260px;overflow:auto;background:var(--inset);
  border-radius:var(--r-sm);padding:8px 10px;font-family:var(--mono);font-size:11.5px;
  line-height:1.7;color:var(--fg-2);white-space:pre-wrap;word-break:break-all}

/* 运行时的轮播提示：一行、右对齐、弱色——不抢面板上的结论 */
.stream-tip{font-size:11.5px;color:var(--faint);max-width:52%;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap;text-align:right}

/* ── 依赖行点开后的详情块 ──────────────────────────────────
   等宽值 + 左列标签，和「将创建什么」用同一套读法。
   有这一块之后 tooltip 只是锦上添花，不再是唯一入口。 */
.dep-fact{margin:0 6px 6px;padding:8px 10px;background:var(--inset);border-radius:var(--r-sm);
  display:grid;grid-template-columns:44px minmax(0,1fr);gap:2px var(--s3);font-size:11.5px;
  animation:popIn 140ms var(--ease-spring);transform-origin:top center}
.dep-fact .df-k{color:var(--muted)}
.dep-fact .df-v{font-family:var(--mono);color:var(--fg-2);overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}

/* ── 机器清单：值不许折行断词 ─────────────────────────────
   截图里 "AMD Ryzen 5 5600X 6-Core Proc / essor" 被折在中间，
   因为网格列宽不够时中文之外的词也会硬断。截断 + 悬停看全才是对的。 */
#view-machine .dgrid{grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:var(--s2)}
#view-machine .fact .v{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
#view-machine .fact{min-width:0}
#view-machine .fact .k{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* 长环境变量：默认一行摘要，点开才是全文 */
#view-machine .fact .v.long{white-space:normal;font-family:var(--font)}
#view-machine .fact .v.long summary{cursor:pointer;font-family:var(--mono);font-size:11.5px;
  color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#view-machine .fact .v.long summary:hover{color:var(--fg-2)}
#view-machine .fullval{margin-top:4px;font-family:var(--mono);font-size:11px;color:var(--fg-2);
  word-break:break-all;background:var(--inset);border-radius:var(--r-xs);padding:6px 8px;max-height:180px;overflow:auto}
/* **图谱页的画布铺满整个内容区**（2026-10-18 用户明确要求，之前的实现不合格）：
   以前它只是"一张卡片里的画布"——`main` 有内边距、`.view` 还被 max-width:1240px 限宽居中，
   所以窗口越大，画布两侧留白越多。**画布是这个界面本身，不是卡片里的一张图。**
   信息窗（节点/边、角色图例、目录、最近运行、按钮）仍然浮在画布上，靠右。
   边界：**只有图谱页这样**，别的页是文档流，铺满反而难读。 */
main:has(#view-graph.on) { padding: 0; overflow: hidden; }
#view-graph.on {
  display: flex; flex-direction: column;
  max-width: none; margin: 0; padding: 0; height: 100%;
}
#view-graph .graph-wrap { flex: 1 1 auto; min-height: 0; border-radius: 0; }

/* ── 图谱：画布是主体（和编辑器同一条规矩：画布不是卡片）──────── */
.graph-wrap { position:relative; width:100%; height:100%; overflow:hidden; background:var(--sunken); }
#graphCv { display:block; width:100%; height:100%; cursor:grab; }
#graphCv:active { cursor:grabbing; }
.graph-hud {
  position:absolute; right:var(--s3); top:var(--s3); padding:var(--s2) var(--s3);
  border-radius:var(--r); background:var(--surface); border:1px solid var(--line);
  box-shadow:var(--shadow-2); font-size:var(--fs-sm); min-width:190px;
}
.graph-hud .gh-row { font-variant-numeric:tabular-nums; }
.graph-hud .gh-sub { color:var(--muted); font-size:11.5px; margin-top:2px; }
.graph-hud .gh-btns { display:flex; gap:6px; margin-top:var(--s2); }

/* 图谱页的角色图例（框架.md §4.8）：一行、带色点、不抢画布的戏。
   为什么不做成侧栏或卡片——**读图的时候眼睛在画布上**，
   图例只是在说"这些颜色是什么意思"，多一分都是噪音。 */
.gh-roles { display: flex; flex-wrap: wrap; gap: 10px; margin: 4px 0 6px; font-size: 12px; color: var(--muted, #8a7f74); }
.gh-roles .gr-role { display: inline-flex; align-items: center; gap: 4px; }
.gh-roles .gr-role i { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.gh-roles .gr-role b { font-weight: 600; color: var(--fg, #3a3229); }

/* **这台机器缺什么**：运行失败时只多这一块，四行，不堆。 */
.missing {
  margin-top: 8px;
  padding: 8px 10px;
  border-left: 3px solid var(--warn);
  background: rgba(255, 193, 7, 0.06);
  border-radius: 4px;
  font-size: 12px;
}
.missing .miss-head { margin-bottom: 4px; }
.missing .miss-line { color: var(--dim); line-height: 1.6; }
.missing .miss-line span { display: inline-block; min-width: 64px; color: var(--dim); }
.missing code { color: var(--fg); word-break: break-all; }

/* **「验一下能不能构建」**：四态四种颜色——最后那一态（我们没验成）不是"失败"。 */
.verify-row{display:flex;align-items:center;gap:10px;margin:10px 0 6px}
.verify-row .hint{font-size:12px;color:var(--dim)}
#verifyResult{margin:6px 0 10px}
.verdict.skip{background:var(--bg2);border:1px solid var(--line);color:var(--dim)}
.verdict.ask{background:rgba(255,193,7,.10);border:1px solid rgba(255,193,7,.45)}
